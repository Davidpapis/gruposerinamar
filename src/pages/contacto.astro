---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/ui/Hero.astro';

const departments = [
  { name: 'Reservas de alojamientos', phone: '+34 952 81 33 62', email: 'reservas@serinamar.com', whatsapp: '34951794931', badge: 'Tu estancia' },
  { name: 'Compra y venta', phone: '+34 678 48 75 94', email: 'info@serinamar.com', whatsapp: '34678487594', badge: 'Serinamar' },
  { name: 'Cuidado de viviendas', phone: '+34 952 81 33 62', email: 'admin@justbanus.com', whatsapp: '34951794931', badge: 'Just Banús' },
  { name: 'Propietarios no residentes', phone: '+34 678 48 75 94', email: 'sara@iberiansun.co.uk', whatsapp: '34951794931', badge: 'Iberiansun' }
];

---

<BaseLayout title="Contacto y Recepción en Los Naranjos | Grupo Serinamar" description="Contacta con Grupo Serinamar por teléfono, correo o WhatsApp. Visita nuestra recepción en el Centro Comercial Los Naranjos de Marbella, Local 5." canonicalURL="https://gruposerinamar.com/contacto/">
  <Header slot="header" currentLang="es" />
  <Hero eyebrow="Contacto · Marbella" title="Contacto y Recepción en Marbella · Los Naranjos" description="Para preparar tu estancia o cuidar de tu propiedad, te ayudamos a encontrar al equipo adecuado." image="/images/hero/entorno.webp" imageAlt="Paseo urbano en el entorno de Marbella" actionLabel="Escribir una consulta" actionHref="#consulta" secondaryLabel="Llamar a recepción" secondaryHref="tel:+34952813362" />

  <section class="page-section">
    <div class="section-heading"><p class="eyebrow">Contacto directo</p><h2>¿En qué podemos ayudarte?</h2></div>
    <div class="departments">{departments.map(dept => <article class="card"><p class="eyebrow">{dept.badge}</p><h3>{dept.name}</h3><a class="contact-detail" href={`tel:${dept.phone.replace(/\s/g, '')}`}>{dept.phone}</a><a class="contact-detail" href={`mailto:${dept.email}`}>{dept.email}</a><div class="actions"><a class="text-link" href={`https://wa.me/${dept.whatsapp}?text=${encodeURIComponent('Hola, quiero consultar sobre ' + dept.name)}`} target="_blank" rel="noopener noreferrer">Abrir WhatsApp ↗</a></div></article>)}</div>
  </section>
  <section class="section-tint"><div class="page-section contact-grid">
    <div id="consulta"><p class="eyebrow">Cuéntanos qué necesitas</p><h2>Prepara tu consulta.</h2>
      <form id="contact-form" class="contact-form">
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
        <div><label for="contact-name">Nombre y apellidos</label><input id="contact-name" name="nombre" autocomplete="name" required /></div>
        <div><label for="contact-email">Correo electrónico</label><input id="contact-email" name="email" type="email" autocomplete="email" required /></div>
        <div><label for="contact-phone">Teléfono</label><input id="contact-phone" name="telefono" type="tel" autocomplete="tel" /></div>
        <div><label for="contact-department">¿Con qué equipo?</label><select id="contact-department" name="departamento">{departments.map(dept => <option value={dept.email}>{dept.name}</option>)}</select></div>
        <div class="full"><label for="contact-message">Tu mensaje</label><textarea id="contact-message" name="mensaje" rows="5" placeholder="¿Cómo podemos ayudarte?" required></textarea></div>
        <div class="full">
          <button id="contact-submit-btn" class="button" type="submit">Enviar mensaje directo →</button>
          <div id="contact-status-msg" class="mt-3 text-sm font-medium" style="display:none;"></div>
          <p class="form-note">Tu consulta se enviará directamente al equipo de Grupo Serinamar en segundo plano. También puedes contactarnos por teléfono o WhatsApp.</p>
        </div>
      </form>
    </div>
    <aside id="oficina"><div class="card"><p class="eyebrow">Ven a conocernos</p><h3>Oficina y recepción</h3><address class="body-copy" style="font-style:normal"><p><strong>Solutions Serinamar S.L.</strong><br />Urb. Los Naranjos de Marbella<br />Centro Comercial, Local 5<br />29660 Marbella, Málaga</p><p><strong>Horario de oficina</strong><br />Lunes a viernes: 08:00–16:00<br />Sábados y domingos: Cerrado</p><p>Atención de emergencias para huéspedes: 24 horas.</p></address><div class="actions"><a class="text-link" href="https://maps.google.com/?q=Los+Naranjos+de+Marbella+Centro+Comercial" target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a></div></div>
      <iframe class="office-map" title="Ubicación de Grupo Serinamar en Los Naranjos de Marbella" src="https://maps.google.com/maps?q=Los%20Naranjos%20de%20Marbella%20Centro%20Comercial&t=&z=15&ie=UTF8&iwloc=&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </aside>
  </div></section>
  <script>
    const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
    const departmentSelect = document.querySelector<HTMLSelectElement>('#contact-department');
    const submitBtn = document.querySelector<HTMLButtonElement>('#contact-submit-btn');
    const statusMsg = document.querySelector<HTMLDivElement>('#contact-status-msg');

    contactForm?.addEventListener('submit', async event => {
      event.preventDefault();
      if (!contactForm || !submitBtn || !statusMsg) return;

      const values = new FormData(contactForm);
      if (values.get('_honey')) return;

      const departmentEmail = (values.get('departamento') as string) || 'reservas@serinamar.com';
      const departmentName = departmentSelect?.selectedOptions[0]?.textContent || 'Consulta General';

      const originalText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando mensaje...';
      statusMsg.style.display = 'none';

      try {
        const response = await fetch('https://formsubmit.co/ajax/info@serinamar.com', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            'Nombre': values.get('nombre'),
            'Correo': values.get('email'),
            'Teléfono': values.get('telefono') || 'No indicado',
            'Departamento de interés': departmentName,
            'Mensaje': values.get('mensaje'),
            '_subject': `Nueva consulta web: ${departmentName} - ${values.get('nombre')}`,
            '_template': 'table'
          })
        });

        if (response.ok) {
          statusMsg.style.display = 'block';
          statusMsg.className = 'mt-3 p-3 bg-[#f0f9f1] border border-[#bbf7d0] text-[#166534] rounded-lg text-sm';
          statusMsg.innerHTML = '✓ <strong>¡Mensaje enviado con éxito!</strong> Nos pondremos en contacto contigo lo antes posible.';
          contactForm.reset();
        } else {
          throw new Error('Error al enviar');
        }
      } catch (err) {
        statusMsg.style.display = 'block';
        statusMsg.className = 'mt-3 p-3 bg-[#fef2f2] border border-[#fecaca] text-[#991b1b] rounded-lg text-sm';
        statusMsg.innerHTML = 'No se pudo enviar en este momento. Puedes escribirnos directamente a <a href="mailto:info@serinamar.com" class="underline font-semibold">info@serinamar.com</a> o contactarnos por WhatsApp.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  </script>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .page-section { max-width: 1200px; margin: 0 auto; padding: 64px 28px; }
  .section-tint { background: #f3efe7; }
  .intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .section-heading { max-width: 680px; margin-bottom: 32px; }
  .eyebrow { color: #796546; font-size: 12px; letter-spacing: .15em; text-transform: uppercase; font-weight: 700; margin-bottom: 14px; }
  h2 { font-family: var(--font-serif, Georgia, serif); font-size: clamp(30px, 3.4vw, 44px); line-height: 1.12; color: #132238; margin-bottom: 20px; }
  h3 { font-family: var(--font-serif, Georgia, serif); font-size: 25px; line-height: 1.2; color: #132238; margin-bottom: 14px; }
  .body-copy { color: #596575; font-size: 16px; line-height: 1.8; }
  .body-copy p + p { margin-top: 16px; }
  .brand-mark { width: auto; max-width: 180px; height: 60px; object-fit: contain; object-position: left; margin-bottom: 24px; }
  .feature-photo { width: 100%; height: 430px; object-fit: cover; border-radius: 16px; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .cards.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .card { padding: 30px; background: #fff; border: 1px solid #e5dfd4; border-radius: 16px; }
  .card p, .card li { color: #596575; font-size: 15px; line-height: 1.7; }
  .card ul { padding-left: 18px; margin: 20px 0; list-style: disc; }
  .card li + li { margin-top: 8px; }
  .card-number { display: block; color: #9c865f; font-size: 14px; margin-bottom: 20px; }
  .text-link { display: inline-block; color: #132238; font-size: 14px; font-weight: 700; border-bottom: 1px solid #b89c72; padding-bottom: 3px; }
  .text-link:hover { color: #796546; }
  .button { display: inline-flex; justify-content: center; align-items: center; min-height: 48px; padding: 13px 22px; background: #132238; color: white; border: 1px solid #132238; border-radius: 7px; font-size: 14px; font-weight: 600; text-align: center; }
  .button:hover { background: #25415d; }
  .button.sand { background: #e5d6bc; color: #132238; border-color: #e5d6bc; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 26px; align-items: center; }
  .callout { background: #132238; color: white; border-radius: 16px; padding: 40px; display: flex; align-items: center; justify-content: space-between; gap: 32px; }
  .callout h2 { color: white; font-size: clamp(28px, 3vw, 38px); }
  .callout p { color: #d5dce2; max-width: 640px; line-height: 1.7; }
  .callout .button { flex-shrink: 0; }
  .contact-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
  .contact-form .full { grid-column: 1 / -1; }
  label { display: block; font-size: 14px; color: #132238; font-weight: 600; margin-bottom: 9px; }
  input, select, textarea { width: 100%; border: 1px solid #cfd4d9; border-radius: 7px; padding: 13px 14px; color: #132238; background: white; font: inherit; font-size: 16px; }
  input:focus, select:focus, textarea:focus { outline: 2px solid #9c865f; outline-offset: 2px; }
  .form-note { color: #596575; font-size: 13px; line-height: 1.6; margin-top: 12px; }
  @media (max-width: 800px) {
    .page-section { padding: 44px 20px; }
    .intro-grid { grid-template-columns: 1fr; gap: 30px; }
    .cards, .cards.two { grid-template-columns: 1fr; }
    .feature-photo { height: 300px; }
    .card { padding: 25px; }
    .callout { padding: 28px; align-items: flex-start; flex-direction: column; }
    .contact-form { grid-template-columns: 1fr; }
  }
</style>
<style>.departments { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:18px; }.departments .card { padding:24px; }.departments h3 { font-size:23px; min-height:56px; }.contact-detail { display:block; color:#596575; font-size:14px; line-height:1.6; margin-top:10px; overflow-wrap:anywhere; }.contact-detail:hover { color:#132238; text-decoration:underline; }.contact-grid { display:grid; grid-template-columns:minmax(0,1.35fr) minmax(0,1fr); gap:60px; }.office-map { width:100%; height:260px; border:0; border-radius:14px; margin-top:24px; }@media(max-width:1100px) {.departments {grid-template-columns:repeat(2,minmax(0,1fr));}.contact-grid{gap:30px;}}@media(max-width:800px) {.contact-grid { grid-template-columns:1fr;gap:44px; }}@media(max-width:540px){.departments {grid-template-columns:1fr;}.departments h3{min-height:0;}}</style>
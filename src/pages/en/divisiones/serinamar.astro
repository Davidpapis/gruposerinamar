---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Hero from '../../../components/ui/Hero.astro';
---

<BaseLayout title="Holiday Rentals & Real Estate Marbella | Serinamar" description="Holiday rentals and property sales in Marbella & Puerto Banús since 2000. Book directly via Guesty or buy with our experienced local real estate team." canonicalURL="https://gruposerinamar.com/en/divisiones/serinamar/" lang="en">
  <Header slot="header" currentLang="en" />
  
  <div class="bg-[#132238] text-white py-3 px-4 border-b border-[#C5A880]/30 text-center text-xs sm:text-sm flex flex-wrap items-center justify-center gap-3">
    <span class="text-[#C5A880] font-semibold">Official Serinamar Websites:</span>
    <a href="https://www.serinamar.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-[#C5A880] font-medium">Real Estate Sales & Listings: www.serinamar.com ↗</a>
    <span class="text-white/30 hidden sm:inline">|</span>
    <a href="https://serinamar.guestybookings.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-[#C5A880] font-medium">Guesty Direct Booking: serinamar.guestybookings.com ↗</a>
  </div>

  <Hero eyebrow="Serinamar · Established 2000" title="Real Estate & Holiday Rentals in Marbella" description="Whether for a holiday stay, a new home or ongoing property management. An experienced local team supports you every step of the way." image="/images/hero/serinamar-villa-header.jpg" imageAlt="Bright dining room and terrace of a Marbella home" actionLabel="Explore Holiday Stays" actionHref="/alojamientos/" secondaryLabel="Buy a Property" secondaryHref="https://www.serinamar.com/" />

  <section class="page-section">
    <div class="section-heading">
      <img class="brand-mark" src="/images/logos/serinamar-logo.png" alt="Serinamar" loading="lazy" />
      <p class="eyebrow">Two ways to accompany you</p>
      <h2>Holidays and property sales, with dedicated care.</h2>
    </div>
    <div class="cards two">
      <article class="card">
        <span class="card-number">01 · Holiday Rentals</span>
        <h3>Your stay, perfectly cared for.</h3>
        <p>We manage vacation homes and attend to guests and owners directly from our on-site reception in Los Naranjos de Marbella.</p>
        <ul>
          <li>Channel management and multi-lingual guest care throughout the stay.</li>
          <li>Dynamic seasonal pricing powered by leading PMS (Guesty).</li>
          <li>Coordination of housekeeping, maintenance and in-person check-in.</li>
        </ul>
        <div class="actions">
          <a class="button" href="/alojamientos/">View Stays</a>
          <a class="text-link" href="https://serinamar.guestybookings.com" target="_blank" rel="noopener noreferrer">Guesty Booking Portal ↗</a>
        </div>
      </article>

      <article class="card">
        <span class="card-number">02 · Real Estate Sales</span>
        <h3>A home for your next chapter.</h3>
        <p>We help you buy or sell property in Marbella, Nueva Andalucía and Puerto Banús, advising you before, during and after notary deed signing.</p>
        <ul>
          <li>Property search, bespoke marketing and buyer qualification.</li>
          <li>Conveyancing coordination, legal assistance and documentation.</li>
          <li>Seamless handover with property management and care.</li>
        </ul>
        <div class="actions">
          <a class="button" href="https://www.serinamar.com/" target="_blank" rel="noopener noreferrer">Browse Properties ↗</a>
          <a class="text-link" href="#valuation">Request Valuation →</a>
        </div>
      </article>
    </div>
  </section>

  <section id="valuation" class="section-tint">
    <div class="page-section intro-grid" style="align-items:start">
      <div>
        <p class="eyebrow">For Property Owners</p>
        <h2>Let's talk about your property.</h2>
        <p class="body-copy">Tell us where it is located and what you would like to achieve. Our advisory team will assess your home to guide you on sales value or rental yields.</p>
        <div class="actions">
          <a class="text-link" href="https://www.serinamar.com/form_captacion/" target="_blank" rel="noopener noreferrer">Access Real Estate Portal Form ↗</a>
        </div>
      </div>
      <form id="valuation-form" class="contact-form card">
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
        <div><label for="valuation-name">Full Name</label><input id="valuation-name" name="nombre" autocomplete="name" required /></div>
        <div><label for="valuation-email">Email Address</label><input id="valuation-email" name="email" type="email" autocomplete="email" required /></div>
        <div><label for="valuation-phone">Phone Number</label><input id="valuation-phone" name="telefono" type="tel" autocomplete="tel" /></div>
        <div>
          <label for="valuation-purpose">What are you looking for?</label>
          <select id="valuation-purpose" name="objetivo">
            <option>Sell my property</option>
            <option>Holiday rental management</option>
            <option>Purchase a home</option>
            <option>Care & maintenance</option>
          </select>
        </div>
        <div class="full">
          <label for="valuation-property">Property details</label>
          <textarea id="valuation-property" name="propiedad" rows="4" placeholder="Location, property type, number of bedrooms and any details you wish to share." required></textarea>
        </div>
        <div class="full">
          <button id="valuation-submit-btn" class="button" type="submit">Submit Enquiry to Real Estate Desk →</button>
          <div id="valuation-status-msg" class="mt-3 text-sm font-medium" style="display:none;"></div>
          <p class="form-note">Your enquiry will be sent directly to our advisory team in the background.</p>
        </div>
      </form>
    </div>
  </section>

  <script>
    const valuationForm = document.querySelector<HTMLFormElement>('#valuation-form');
    const submitBtn = document.querySelector<HTMLButtonElement>('#valuation-submit-btn');
    const statusMsg = document.querySelector<HTMLDivElement>('#valuation-status-msg');

    valuationForm?.addEventListener('submit', async event => {
      event.preventDefault();
      if (!valuationForm || !submitBtn || !statusMsg) return;

      const values = new FormData(valuationForm);
      if (values.get('_honey')) return;

      const originalText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending enquiry...';
      statusMsg.style.display = 'none';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            nombre: values.get('nombre'),
            email: values.get('email'),
            telefono: values.get('telefono') || 'Not provided',
            departamento: 'Serinamar Real Estate: ' + values.get('objetivo'),
            mensaje: values.get('propiedad'),
            lang: 'en'
          })
        });

        if (response.ok) {
          statusMsg.style.display = 'block';
          statusMsg.className = 'mt-3 p-3 bg-[#f0f9f1] border border-[#bbf7d0] text-[#166534] rounded-lg text-sm';
          statusMsg.innerHTML = '✓ <strong>Enquiry sent successfully!</strong> We have received your request and sent a confirmation receipt to your email.';
          valuationForm.reset();
          return;
        }
        throw new Error('Fallback to backup');
      } catch (err) {
        try {
          const fallback = await fetch('https://formsubmit.co/ajax/info@serinamar.com', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({
              'Name': values.get('nombre'),
              'Email': values.get('email'),
              'Phone': values.get('telefono') || 'Not provided',
              'Purpose': values.get('objetivo'),
              'Property details': values.get('propiedad'),
              '_subject': `New Real Estate Enquiry: ${values.get('objetivo')} - ${values.get('nombre')}`,
              '_template': 'table'
            })
          });

          if (fallback.ok) {
            statusMsg.style.display = 'block';
            statusMsg.className = 'mt-3 p-3 bg-[#f0f9f1] border border-[#bbf7d0] text-[#166534] rounded-lg text-sm';
            statusMsg.innerHTML = '✓ <strong>Enquiry sent successfully!</strong> Our real estate desk will review your message and contact you promptly.';
            valuationForm.reset();
            return;
          }
        } catch(e) {}

        statusMsg.style.display = 'block';
        statusMsg.className = 'mt-3 p-3 bg-[#fef2f2] border border-[#fecaca] text-[#991b1b] rounded-lg text-sm';
        statusMsg.innerHTML = 'Could not send at this moment. You can reach us directly at <a href="mailto:info@serinamar.com" class="underline font-semibold">info@serinamar.com</a> or call +34 952 81 33 62.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  </script>

  <Footer slot="footer" currentLang="en" />
</BaseLayout>

<style>
  .page-section { max-width: 1200px; margin: 0 auto; padding: 64px 28px; }
  .section-tint { background: #f3efe7; }
  .intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .section-heading { max-width: 680px; margin-bottom: 32px; }
  .eyebrow { color: #796546; font-size: 12px; letter-spacing: .15em; text-transform: uppercase; font-weight: 700; margin-bottom: 14px; }
  h2 { font-family: var(--font-serif, Georgia, serif); font-size: clamp(30px, 3.4vw, 44px); line-height: 1.12; color: #132238; margin-bottom: 20px; }
  h3 { font-family: var(--font-serif, Georgia, serif); font-size: 25px; line-height: 1.2; color: #132238; margin-bottom: 14px; }
  .body-copy { color: #596575; font-size: 16px; line-height: 1.8; }
  .body-copy p + p { margin-top: 16px; }
  .brand-mark { width: auto; max-width: 180px; height: 60px; object-fit: contain; object-position: left; margin-bottom: 24px; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .cards.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .card { padding: 30px; background: #fff; border: 1px solid #e5dfd4; border-radius: 16px; }
  .card p, .card li { color: #596575; font-size: 15px; line-height: 1.7; }
  .card ul { padding-left: 18px; margin: 20px 0; list-style: disc; }
  .card li + li { margin-top: 8px; }
  .card-number { display: block; color: #9c865f; font-size: 14px; margin-bottom: 20px; }
  .text-link { display: inline-block; color: #132238; font-size: 14px; font-weight: 700; border-bottom: 1px solid #b89c72; padding-bottom: 3px; }
  .text-link:hover { color: #796546; }
  .button { display: inline-block; padding: 12px 20px; background: #132238; color: #fff; font-size: 14px; font-weight: 600; border-radius: 4px; text-decoration: none; }
  .button:hover { background: #203654; }
  .actions { display: flex; gap: 16px; align-items: center; margin-top: 24px; }
  .contact-form { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .contact-form .full { grid-column: span 2; }
  .contact-form label { display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #132238; margin-bottom: 6px; }
  .contact-form input, .contact-form select, .contact-form textarea { width: 100%; padding: 10px 14px; border: 1px solid #d4cbbd; border-radius: 4px; font-size: 14px; }
  .form-note { font-size: 12px; color: #8a94a0; margin-top: 8px; }
  @media (max-width: 768px) {
    .intro-grid, .cards, .cards.two { grid-template-columns: 1fr; }
    .contact-form { grid-template-columns: 1fr; }
    .contact-form .full { grid-column: span 1; }
  }
</style>


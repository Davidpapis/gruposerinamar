---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Hero from '../../components/ui/Hero.astro';

const departments = [
  { name: 'Holiday Rentals & Stays', phone: '+34 952 81 33 62', email: 'reservas@serinamar.com', whatsapp: '34951794931', badge: 'Your Stay' },
  { name: 'Real Estate Sales & Purchase', phone: '+34 678 48 75 94', email: 'info@serinamar.com', whatsapp: '34678487594', badge: 'Serinamar' },
  { name: 'Property Management & Care', phone: '+34 952 81 33 62', email: 'admin@justbanus.com', whatsapp: '34951794931', badge: 'Just Banús' },
  { name: 'Non-Resident & Tax Advisory', phone: '+34 678 48 75 94', email: 'sara@iberiansun.co.uk', whatsapp: '34951794931', badge: 'Iberiansun' }
];
---

<BaseLayout title="Contact & Reception in Los Naranjos | Grupo Serinamar" description="Contact Grupo Serinamar by phone, email or WhatsApp. Visit our reception at Los Naranjos de Marbella Shopping Centre, Unit 5." canonicalURL="https://gruposerinamar.com/en/contacto/">
  <Header slot="header" currentLang="en" />
  <Hero eyebrow="Contact · Marbella" title="Contact & Reception in Marbella · Los Naranjos" description="Whether you are planning your holiday stay or need comprehensive care for your property, our multilingual team is here to assist you." image="/images/hero/entorno.webp" imageAlt="Sunny residential promenade in Marbella" actionLabel="Send an enquiry" actionHref="#enquiry" secondaryLabel="Call reception" secondaryHref="tel:+34952813362" />

  <section class="page-section">
    <div class="section-heading"><p class="eyebrow">Direct Assistance</p><h2>How can we help you today?</h2></div>
    <div class="departments">{departments.map(dept => <article class="card"><p class="eyebrow">{dept.badge}</p><h3>{dept.name}</h3><a class="contact-detail" href={`tel:${dept.phone.replace(/\s/g, '')}`}>{dept.phone}</a><a class="contact-detail" href={`mailto:${dept.email}`}>{dept.email}</a><div class="actions"><a class="text-link" href={`https://wa.me/${dept.whatsapp}?text=${encodeURIComponent('Hello, I would like to enquire about ' + dept.name)}`} target="_blank" rel="noopener noreferrer">Open WhatsApp ↗</a></div></article>)}</div>
  </section>
  <section class="section-tint"><div class="page-section contact-grid">
    <div id="enquiry"><p class="eyebrow">Send us a message</p><h2>Prepare your enquiry.</h2>
      <form id="contact-form" class="contact-form">
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
        <div><label for="contact-name">Full name</label><input id="contact-name" name="nombre" autocomplete="name" required /></div>
        <div><label for="contact-email">Email address</label><input id="contact-email" name="email" type="email" autocomplete="email" required /></div>
        <div><label for="contact-phone">Telephone number</label><input id="contact-phone" name="telefono" type="tel" autocomplete="tel" /></div>
        <div><label for="contact-department">Department of interest</label><select id="contact-department" name="departamento">{departments.map(dept => <option value={dept.email}>{dept.name}</option>)}</select></div>
        <div class="full"><label for="contact-message">Your message</label><textarea id="contact-message" name="mensaje" rows="5" placeholder="How can our team assist you?" required></textarea></div>
        <div class="full">
          <button id="contact-submit-btn" class="button" type="submit">Send Direct Message →</button>
          <div id="contact-status-msg" class="mt-3 text-sm font-medium" style="display:none;"></div>
          <p class="form-note">Your enquiry will be sent directly to Grupo Serinamar. You can also reach our team via telephone or WhatsApp.</p>
        </div>
      </form>
    </div>
    <aside id="office"><div class="card"><p class="eyebrow">Visit our team</p><h3>Office & reception desk</h3><address class="body-copy" style="font-style:normal"><p><strong>Solutions Serinamar S.L.</strong><br />Urb. Los Naranjos de Marbella<br />Centro Comercial, Local 5<br />29660 Marbella, Málaga, Spain</p><p><strong>Office hours</strong><br />Monday to Friday: 08:00–16:00<br />Saturday & Sunday: Closed</p><p>24-hour emergency guest support available.</p></address><div class="actions"><a class="text-link" href="https://maps.google.com/?q=Los+Naranjos+de+Marbella+Centro+Comercial" target="_blank" rel="noopener noreferrer">Get directions ↗</a></div></div>
      <iframe class="office-map" title="Grupo Serinamar location at Los Naranjos de Marbella" src="https://maps.google.com/maps?q=Los%20Naranjos%20de%20Marbella%20Centro%20Comercial&t=&z=15&ie=UTF8&iwloc=&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </aside>
  </div></section>
  <script>
    const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
    const departmentSelect = document.querySelector<HTMLSelectElement>('#contact-department');
    const submitBtn = document.querySelector<HTMLButtonElement>('#contact-submit-btn');
    const statusMsg = document.querySelector<HTMLDivElement>('#contact-status-msg');

    contactForm?.addEventListener('submit', async event => {
      event.preventDefault();
      if (!contactForm || !submitBtn || !statusMsg) return;

      const values = new FormData(contactForm);
      if (values.get('_honey')) return;

      const departmentName = departmentSelect?.selectedOptions[0]?.textContent || 'General Enquiry';

      const originalText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending message...';
      statusMsg.style.display = 'none';

      try {
        // 1. Envío prioritario con Resend (versión en inglés)
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            nombre: values.get('nombre'),
            email: values.get('email'),
            telefono: values.get('telefono') || 'Not provided',
            departamento: departmentName,
            mensaje: values.get('mensaje'),
            lang: 'en'
          })
        });

        if (res.ok) {
          statusMsg.style.display = 'block';
          statusMsg.className = 'mt-3 p-3 bg-[#f0f9f1] border border-[#bbf7d0] text-[#166534] rounded-lg text-sm';
          statusMsg.innerHTML = '✓ <strong>Message sent successfully!</strong> We have safely received your enquiry and sent a confirmation receipt to your email.';
          contactForm.reset();
          return;
        }
        throw new Error('Fallback to backup');
      } catch (err) {
        // 2. Respaldo automático
        try {
          const fallback = await fetch('https://formsubmit.co/ajax/info@serinamar.com', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({
              'Name': values.get('nombre'),
              'Email': values.get('email'),
              'Phone': values.get('telefono') || 'Not provided',
              'Department': departmentName,
              'Message': values.get('mensaje'),
              '_subject': `New Web Enquiry [EN]: ${departmentName} - ${values.get('nombre')}`,
              '_template': 'table'
            })
          });

          if (fallback.ok) {
            statusMsg.style.display = 'block';
            statusMsg.className = 'mt-3 p-3 bg-[#f0f9f1] border border-[#bbf7d0] text-[#166534] rounded-lg text-sm';
            statusMsg.innerHTML = '✓ <strong>Message sent successfully!</strong> Our team will review your message and get back to you shortly.';
            contactForm.reset();
            return;
          }
        } catch(e) {}

        statusMsg.style.display = 'block';
        statusMsg.className = 'mt-3 p-3 bg-[#fef2f2] border border-[#fecaca] text-[#991b1b] rounded-lg text-sm';
        statusMsg.innerHTML = 'Could not send at this moment. You can write to us directly at <a href="mailto:info@serinamar.com" class="underline font-semibold">info@serinamar.com</a> or message us on WhatsApp.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  </script>

  <Footer slot="footer" currentLang="en" />
</BaseLayout>

<style>
  .page-section { max-width: 1200px; margin: 0 auto; padding: 64px 28px; }
  .section-tint { background: #f3efe7; }
  .intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .section-heading { max-width: 680px; margin-bottom: 32px; }
  .eyebrow { color: #796546; font-size: 12px; letter-spacing: .15em; text-transform: uppercase; font-weight: 700; margin-bottom: 14px; }
  h2 { font-family: var(--font-serif, Georgia, serif); font-size: clamp(30px, 3.4vw, 44px); line-height: 1.12; color: #132238; margin-bottom: 20px; }
  h3 { font-family: var(--font-serif, Georgia, serif); font-size: 25px; line-height: 1.2; color: #132238; margin-bottom: 14px; }
  .body-copy { color: #596575; font-size: 16px; line-height: 1.8; }
  .departments { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .card { padding: 28px 24px; background: #fff; border: 1px solid #e5dfd4; border-radius: 12px; }
  .card h3 { font-size: 18px; margin-bottom: 12px; }
  .contact-detail { display: block; color: #132238; font-size: 14px; font-weight: 600; margin-bottom: 6px; text-decoration: none; }
  .contact-detail:hover { color: #796546; }
  .text-link { display: inline-block; color: #796546; font-size: 13px; font-weight: 600; text-decoration: none; margin-top: 10px; }
  .text-link:hover { text-decoration: underline; }
  .contact-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 50px; }
  .contact-form { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 24px; }
  .contact-form .full { grid-column: span 2; }
  .contact-form label { display: block; font-size: 13px; font-weight: 600; color: #132238; margin-bottom: 6px; }
  .contact-form input, .contact-form select, .contact-form textarea { width: 100%; padding: 12px 14px; border: 1px solid #d4cbbd; border-radius: 6px; font-size: 14px; background: #fff; font-family: inherit; }
  .contact-form input:focus, .contact-form select:focus, .contact-form textarea:focus { outline: none; border-color: #132238; ring: 2px solid rgba(19,34,56,0.1); }
  .button { display: inline-block; padding: 14px 28px; background: #132238; color: #fff; font-size: 15px; font-weight: 600; border-radius: 6px; border: none; cursor: pointer; transition: background 0.2s; }
  .button:hover { background: #1e3557; }
  .form-note { font-size: 12px; color: #796546; margin-top: 10px; }
  .office-map { width: 100%; height: 260px; border: 0; border-radius: 12px; margin-top: 20px; }
  @media (max-width: 900px) {
    .departments { grid-template-columns: 1fr 1fr; }
    .contact-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .departments { grid-template-columns: 1fr; }
    .contact-form { grid-template-columns: 1fr; }
    .contact-form .full { grid-column: span 1; }
  }
</style>

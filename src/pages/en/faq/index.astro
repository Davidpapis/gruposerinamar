---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import faqs from '../../../data/freshdesk_faq_en.json';

const title = "Help Center, Support & FAQ (SAC) | Grupo Serinamar";
const description = "Grupo Serinamar customer support and knowledge base: holiday rentals, check-in, owner services (Just Banús), and non-resident tax advisory (Iberiansun). Open a support ticket.";
const canonicalURL = "https://gruposerinamar.com/en/faq/";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.title,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.content
    }
  }))
};

const categoryList = [
  { id: 'All', name: 'All Questions', count: faqs.length, icon: '📋' },
  { id: 'Stays & Guests', name: 'Stays & Guests', count: faqs.filter(f => f.category === 'Stays & Guests').length, icon: '🏖️' },
  { id: 'Apartment Guide', name: 'Apartment Guide', count: faqs.filter(f => f.category === 'Apartment Guide').length, icon: '📖' },
  { id: 'Owner Services (Just Banús)', name: 'Owners & Maintenance (Just Banús)', count: faqs.filter(f => f.category === 'Owner Services (Just Banús)').length, icon: '🔑' },
  { id: 'Fiscal & Non-Residents (Iberiansun)', name: 'Fiscal & Non-Residents (Iberiansun)', count: faqs.filter(f => f.category === 'Fiscal & Non-Residents (Iberiansun)').length, icon: '🇬🇧' },
  { id: 'Real Estate & Investment', name: 'Real Estate & Investment', count: faqs.filter(f => f.category === 'Real Estate & Investment').length, icon: '🏡' },
  { id: 'Rentals & Key Holding', name: 'Rentals & Key Holding', count: faqs.filter(f => f.category === 'Rentals & Key Holding').length, icon: '🛡️' }
];

const divisionLogos: Record<string, string> = {
  'Serinamar': '/images/logos/serin-logo-trimmed.png',
  'Just Banús': '/images/logos/jb-logo-trimmed.png',
  'Iberiansun': '/images/logos/iberian-logo-trimmed.png'
};
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL} lang="en">
  <Header slot="header" currentLang="en" />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO SECTION SAC (EN) -->
  <section class="bg-gradient-to-b from-[#132238] via-[#1a2d47] to-[#132238] text-white pt-16 pb-20 px-4 sm:px-6 lg:px-8 border-b border-[#2a3f5f]">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 border border-white/15 text-xs text-[#dec7a7] uppercase tracking-widest font-medium mb-4">
        <span>Customer Support Center (SAC)</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#25D366]"></span>
        <span>Knowledge Base</span>
      </div>
      
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-white tracking-tight mb-4 leading-tight">
        How can we help you today?
      </h1>
      
      <p class="text-sm sm:text-base text-[#c7d2e0] max-w-2xl mx-auto leading-relaxed mb-8">
        Find quick answers regarding your holiday stay, property maintenance and key holding by <strong class="text-white">Just Banús</strong>, or UK non-resident tax and administrative support by <strong class="text-white">Iberiansun</strong>.
      </p>

      <!-- Real-time search bar -->
      <div class="relative max-w-2xl mx-auto text-left">
        <div class="faq-search-box relative flex items-center shadow-2xl rounded-2xl bg-white border border-[#EAE3D9] focus-within:border-[#C5A880] focus-within:ring-4 focus-within:ring-[#C5A880]/20 transition-all min-h-[58px] px-4">
          <span class="text-slate-400 shrink-0 mr-2.5 flex items-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </span>
          <input 
            type="text" 
            id="faq-search-input" 
            placeholder="Search keywords: check-in, keys, Modelo 210, storage rooms, taxi, cleaning..."
            class="w-full h-8 py-0 pl-1 pr-10 text-[#132238] text-sm sm:text-base placeholder:text-slate-400 bg-transparent border-0 outline-none focus:outline-none focus:ring-0 leading-normal"
            autocomplete="off"
          />
          <button 
            type="button" 
            id="faq-search-clear" 
            class="hidden absolute right-3 p-1.5 text-slate-400 hover:text-slate-600 rounded-full text-xs cursor-pointer"
            aria-label="Clear search"
          >
            ✕
          </button>
        </div>
        <div class="flex items-center justify-between text-xs text-[#94a3b8] mt-2.5 px-2">
          <span id="faq-counter">Showing all {faqs.length} official answers</span>
          <span class="hidden sm:inline">Real-time search</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FRESHDESK TICKETS BANNER (EN) -->
  <section class="max-w-5xl mx-auto px-4 -mt-8 relative z-20">
    <div class="bg-white rounded-2xl border border-[#EAE3D9] shadow-xl p-5 sm:p-6 flex flex-col md:flex-row items-center justify-between gap-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-[#FAF8F5] border border-[#EAE3D9] flex items-center justify-center text-2xl shrink-0">
          🎫
        </div>
        <div>
          <h2 class="text-base font-bold text-[#132238] flex items-center gap-2">
            Freshdesk SAC Support Ticket Portal
            <span class="text-[10px] bg-[#132238]/5 text-[#132238] px-2 py-0.5 rounded font-mono uppercase">Official</span>
          </h2>
          <p class="text-xs text-[#5c6570] mt-0.5">
            Do you have a specific incident or require dedicated assistance with your property?
          </p>
        </div>
      </div>
      
      <div class="flex items-center gap-3 w-full md:w-auto shrink-0">
        <a 
          href="https://solutionsserinamar.freshdesk.com/support/tickets/new" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex-1 md:flex-none inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-[#132238] hover:bg-[#203654] text-white text-xs sm:text-sm font-semibold rounded-xl shadow-md transition-all duration-200"
        >
          <span>Open New Support Ticket</span>
          <span>↗</span>
        </a>
        <a 
          href="https://solutionsserinamar.freshdesk.com/support/tickets" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex-1 md:flex-none inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-[#FAF8F5] hover:bg-[#EAE3D9] text-[#132238] border border-[#EAE3D9] text-xs sm:text-sm font-medium rounded-xl transition-colors"
        >
          <span>Check Status</span>
          <span>↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- MAIN FAQ ACCORDION (EN) -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    
    <div class="flex flex-wrap items-center gap-2.5 mb-8" id="category-filters">
      {categoryList.map((cat, idx) => (
        <button 
          type="button" 
          data-category={cat.id}
          class={`cat-filter-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold transition-all duration-200 cursor-pointer border shadow-2xs ${idx === 0 ? 'bg-[#132238] text-white border-[#132238] shadow-sm' : 'bg-white text-[#5c6570] border-[#EAE3D9] hover:border-[#C5A880] hover:text-[#132238]'}`}
        >
          <span>{cat.icon}</span>
          <span>{cat.name}</span>
          <span class={`text-[10.5px] px-1.5 py-0.2 rounded-full ${idx === 0 ? 'bg-white/20 text-white' : 'bg-[#FAF8F5] text-[#806847]'}`}>
            {cat.count}
          </span>
        </button>
      ))}
    </div>

    <div class="space-y-4" id="faq-list">
      {faqs.map((faq) => (
        <details 
          class="faq-item group bg-white rounded-2xl border border-[#EAE3D9] hover:border-[#C5A880]/70 transition-all duration-200 overflow-hidden shadow-xs hover:shadow-md"
          data-title={faq.title.toLowerCase()}
          data-category={faq.category}
          data-division={faq.division}
          data-content={faq.content.toLowerCase()}
        >
          <summary class="flex items-center justify-between p-5 sm:p-6 cursor-pointer list-none select-none">
            <div class="flex items-start sm:items-center gap-3.5 pr-4">
              <div class="w-8 h-8 rounded-lg bg-[#FAF8F5] border border-[#EAE3D9] flex items-center justify-center shrink-0 p-1">
                <img 
                  src={divisionLogos[faq.division] || '/images/logos/casita-logo-no-bg.png'} 
                  alt={faq.division} 
                  class="max-h-5 max-w-full object-contain" 
                  loading="lazy"
                />
              </div>
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-[#806847] bg-[#FAF8F5] px-2 py-0.5 rounded border border-[#EAE3D9]">
                    {faq.division} · {faq.category}
                  </span>
                </div>
                <h3 class="text-sm sm:text-base font-serif font-bold text-[#132238] group-hover:text-[#806847] transition-colors leading-snug">
                  {faq.title}
                </h3>
              </div>
            </div>
            
            <span class="w-7 h-7 rounded-full bg-[#FAF8F5] border border-[#EAE3D9] flex items-center justify-center text-[#132238] group-open:rotate-180 transition-transform duration-200 shrink-0 text-xs">
              ▼
            </span>
          </summary>

          <div class="px-5 sm:px-6 pb-6 pt-2 border-t border-[#FAF8F5] text-xs sm:text-sm text-[#475569] leading-relaxed">
            <div class="whitespace-pre-line bg-[#FDFBF7] p-4 rounded-xl border border-[#EAE3D9]/60 mb-4 font-sans text-[13px]">
              {faq.content}
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 pt-2 text-xs">
              <span class="text-[#64748b]">
                Official Grupo Serinamar Support Knowledge Base
              </span>
              <a 
                href={faq.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1.5 text-[#806847] hover:text-[#132238] font-semibold hover:underline"
              >
                <span>Read original article on Freshdesk</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        </details>
      ))}

      <div id="faq-no-results" class="hidden text-center py-16 bg-white rounded-2xl border border-dashed border-[#EAE3D9] p-8">
        <span class="text-4xl mb-3 block">🔍</span>
        <h3 class="text-base font-bold text-[#132238] mb-1">No matching results found</h3>
        <p class="text-xs sm:text-sm text-[#64748b] max-w-md mx-auto mb-6">
          Try alternative search keywords or open a support ticket on Freshdesk so our team can directly address your case.
        </p>
        <a 
          href="https://solutionsserinamar.freshdesk.com/support/tickets/new" 
          target="_blank" 
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#132238] text-white text-xs font-semibold rounded-xl hover:bg-[#203654] transition-colors"
        >
          <span>Open Ticket on Freshdesk</span>
          <span>↗</span>
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" currentLang="en" />
</BaseLayout>

<style>
  /* Remove unwanted focus-visible outline inside the search bar */
  #faq-search-input,
  #faq-search-input:focus,
  #faq-search-input:focus-visible {
    outline: none !important;
    outline-offset: 0 !important;
    box-shadow: none !important;
    border: none !important;
  }
</style>

<script>
  function setupFaqSearch() {
    const searchInput = document.getElementById('faq-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('faq-search-clear');
    const faqItems = document.querySelectorAll<HTMLElement>('.faq-item');
    const counter = document.getElementById('faq-counter');
    const noResults = document.getElementById('faq-no-results');
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.cat-filter-btn');

    let currentCategory = 'All';

    function filterFaqs() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let visibleCount = 0;

      if (clearBtn) {
        if (query.length > 0) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }

      faqItems.forEach((item) => {
        const title = item.dataset.title || '';
        const cat = item.dataset.category || '';
        const div = item.dataset.division || '';
        const content = item.dataset.content || '';

        const matchesQuery = !query || 
          title.includes(query) || 
          cat.toLowerCase().includes(query) || 
          div.toLowerCase().includes(query) || 
          content.includes(query);

        const matchesCategory = currentCategory === 'All' || cat === currentCategory;

        if (matchesQuery && matchesCategory) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (counter) {
        counter.textContent = `Showing ${visibleCount} of ${faqItems.length} answers`;
      }

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', filterFaqs);

    clearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
        filterFaqs();
      }
    });

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.className = 'cat-filter-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold transition-all duration-200 cursor-pointer border shadow-2xs bg-white text-[#5c6570] border-[#EAE3D9] hover:border-[#C5A880] hover:text-[#132238]';
          const countSpan = b.querySelector('span:last-child');
          if (countSpan) countSpan.className = 'text-[10.5px] px-1.5 py-0.2 rounded-full bg-[#FAF8F5] text-[#806847]';
        });
        btn.className = 'cat-filter-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold transition-all duration-200 cursor-pointer border shadow-sm bg-[#132238] text-white border-[#132238]';
        const activeCount = btn.querySelector('span:last-child');
        if (activeCount) activeCount.className = 'text-[10.5px] px-1.5 py-0.2 rounded-full bg-white/20 text-white';
        currentCategory = btn.dataset.category || 'All';
        filterFaqs();
      });
    });
  }

  setupFaqSearch();
  document.addEventListener('astro:page-load', setupFaqSearch);
</script>


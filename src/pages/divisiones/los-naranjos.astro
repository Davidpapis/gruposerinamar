---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Hero from '../../components/ui/Hero.astro';

const highlights = [
  { title: 'Piscinas y jardines', description: 'Zonas comunitarias para descansar y disfrutar del clima de Marbella.' },
  { title: 'Deporte y restauración', description: 'Club de pádel y opciones de restauración en el entorno de la urbanización.' },
  { title: 'Compras del día a día', description: 'Supermercado y servicios en el centro comercial de Los Naranjos.' },
  { title: 'Cerca de Puerto Banús', description: 'Una base en Nueva Andalucía para descubrir la costa, sus playas y campos de golf.' }
];

---

<BaseLayout title="Los Naranjos de Marbella · Alojamientos y entorno | Grupo Serinamar" description="Conoce Los Naranjos de Marbella: arquitectura andaluza, piscinas y jardines en Nueva Andalucía. Encuentra tu alojamiento con Serinamar." canonicalURL="https://gruposerinamar.com/divisiones/los-naranjos/">
  <Header slot="header" currentLang="es" />
  <Hero eyebrow="Nueva Andalucía · Marbella" title="Días tranquilos en Los Naranjos." description="Arquitectura andaluza, piscinas y terrazas para disfrutar de Marbella a tu ritmo." image="/images/hero/naranjos-fase2.webp" imageAlt="Piscina comunitaria rodeada de jardines y edificios blancos en Los Naranjos de Marbella" actionLabel="Ver alojamientos" actionHref="/alojamientos/" secondaryLabel="Consultar disponibilidad" secondaryHref="https://serinamar.guestybookings.com" />

  <section class="page-section intro-grid">
    <div><img class="brand-mark" src="/images/logos/los-naranjos-logo.png" alt="Los Naranjos de Marbella" loading="lazy" /><p class="eyebrow">Tu estancia en Marbella</p><h2>La vida mediterránea, a tu ritmo.</h2><div class="body-copy"><p>Los Naranjos de Marbella reúne viviendas de estilo andaluz, jardines y piscinas comunitarias en Nueva Andalucía, cerca de Puerto Banús.</p><p>Nuestro equipo te recibe en el Centro Comercial Los Naranjos, Local 5, y te acompaña durante tu estancia.</p></div><div class="actions"><a class="text-link" href="/contacto/">Contactar con recepción →</a></div></div>
    <img class="feature-photo" src="/images/hero/naranjos-pool.jpg" alt="Fachadas blancas y palmeras de Los Naranjos de Marbella" loading="lazy" />
  </section>
  <section class="section-tint"><div class="page-section"><div class="section-heading"><p class="eyebrow">El entorno</p><h2>Todo cerca para disfrutar más.</h2></div><div class="cards two">
    {highlights.map(item => <article class="card"><h3>{item.title}</h3><p>{item.description}</p></article>)}
  </div></div></section>
  <section class="page-section">
    <div class="section-heading"><p class="eyebrow">Una mirada a Los Naranjos</p><h2>Terrazas, paseos y aire libre.</h2></div>
    <div class="photo-gallery"><figure><img src="/images/hero/naranjos-gardens.jpg" alt="Terraza amueblada junto a una vivienda en Los Naranjos" loading="lazy" /><figcaption>Espacios para disfrutar al aire libre.</figcaption></figure><figure><img src="/images/hero/entorno.webp" alt="Paseo urbano y entorno de Marbella" loading="lazy" /><figcaption>El entorno de Marbella.</figcaption></figure></div>
    <div class="actions"><a class="button" href="/alojamientos/">Encontrar mi alojamiento →</a><a class="text-link" href="https://serinamar.guestybookings.com" target="_blank" rel="noopener noreferrer">Consultar fechas y precios ↗</a></div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .page-section { max-width: 1200px; margin: 0 auto; padding: 64px 28px; }
  .section-tint { background: #f3efe7; }
  .intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .section-heading { max-width: 680px; margin-bottom: 32px; }
  .eyebrow { color: #796546; font-size: 12px; letter-spacing: .15em; text-transform: uppercase; font-weight: 700; margin-bottom: 14px; }
  h2 { font-family: var(--font-serif, Georgia, serif); font-size: clamp(30px, 3.4vw, 44px); line-height: 1.12; color: #132238; margin-bottom: 20px; }
  h3 { font-family: var(--font-serif, Georgia, serif); font-size: 25px; line-height: 1.2; color: #132238; margin-bottom: 14px; }
  .body-copy { color: #596575; font-size: 16px; line-height: 1.8; }
  .body-copy p + p { margin-top: 16px; }
  .brand-mark { width: auto; max-width: 180px; height: 60px; object-fit: contain; object-position: left; margin-bottom: 24px; }
  .feature-photo { width: 100%; height: 430px; object-fit: cover; border-radius: 16px; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .cards.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .card { padding: 30px; background: #fff; border: 1px solid #e5dfd4; border-radius: 16px; }
  .card p, .card li { color: #596575; font-size: 15px; line-height: 1.7; }
  .card ul { padding-left: 18px; margin: 20px 0; list-style: disc; }
  .card li + li { margin-top: 8px; }
  .card-number { display: block; color: #9c865f; font-size: 14px; margin-bottom: 20px; }
  .text-link { display: inline-block; color: #132238; font-size: 14px; font-weight: 700; border-bottom: 1px solid #b89c72; padding-bottom: 3px; }
  .text-link:hover { color: #796546; }
  .button { display: inline-flex; justify-content: center; align-items: center; min-height: 48px; padding: 13px 22px; background: #132238; color: white; border: 1px solid #132238; border-radius: 7px; font-size: 14px; font-weight: 600; text-align: center; }
  .button:hover { background: #25415d; }
  .button.sand { background: #e5d6bc; color: #132238; border-color: #e5d6bc; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 26px; align-items: center; }
  .callout { background: #132238; color: white; border-radius: 16px; padding: 40px; display: flex; align-items: center; justify-content: space-between; gap: 32px; }
  .callout h2 { color: white; font-size: clamp(28px, 3vw, 38px); }
  .callout p { color: #d5dce2; max-width: 640px; line-height: 1.7; }
  .callout .button { flex-shrink: 0; }
  .contact-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
  .contact-form .full { grid-column: 1 / -1; }
  label { display: block; font-size: 14px; color: #132238; font-weight: 600; margin-bottom: 9px; }
  input, select, textarea { width: 100%; border: 1px solid #cfd4d9; border-radius: 7px; padding: 13px 14px; color: #132238; background: white; font: inherit; font-size: 16px; }
  input:focus, select:focus, textarea:focus { outline: 2px solid #9c865f; outline-offset: 2px; }
  .form-note { color: #596575; font-size: 13px; line-height: 1.6; margin-top: 12px; }
  @media (max-width: 800px) {
    .page-section { padding: 44px 20px; }
    .intro-grid { grid-template-columns: 1fr; gap: 30px; }
    .cards, .cards.two { grid-template-columns: 1fr; }
    .feature-photo { height: 300px; }
    .card { padding: 25px; }
    .callout { padding: 28px; align-items: flex-start; flex-direction: column; }
    .contact-form { grid-template-columns: 1fr; }
  }
</style>
<style>.photo-gallery { display:grid; grid-template-columns:1fr 1fr; gap:24px; }.photo-gallery img { width:100%; height:320px; object-fit:cover; border-radius:14px; } figcaption { color:#596575; font-size:14px; margin-top:12px; } @media(max-width:700px) { .photo-gallery { grid-template-columns:1fr; }.photo-gallery img { height:260px; } }</style>
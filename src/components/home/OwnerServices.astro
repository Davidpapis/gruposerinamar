---

<section id="propietarios" class="py-20 md:py-28 px-4 sm:px-8 max-w-7xl mx-auto">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 reveal-on-scroll">
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#EAE3D9] text-[#132238] text-xs font-semibold tracking-wider uppercase mb-3 shadow-xs">
        <span>Just Banús & Iberian Sun</span>
      </div>
      <h2 class="text-3xl md:text-5xl font-serif text-[#132238] leading-tight mb-4">
        Servicios Exclusivos para Propietarios
      </h2>
      <p class="text-[#64748B] text-base md:text-lg font-light">
        Gestión patrimonial integral diseñada para que disfrute de su casa en Marbella cuando venga, y maximice su rendimiento y seguridad cuando esté fuera.
      </p>
    </div>

    <div class="shrink-0 flex items-center gap-4">
      <a href="/divisiones/just-banus/" class="hover-lift inline-block p-2.5 bg-white rounded-2xl border border-[#EAE3D9] shadow-xs">
        <img src="/images/logos/just-banus-logo.png" alt="Just Banús Logo" class="h-10 w-auto object-contain" />
      </a>
      <a href="/divisiones/iberian-sun/" class="hover-lift inline-block p-2.5 bg-white rounded-2xl border border-[#EAE3D9] shadow-xs">
        <img src="/images/logos/iberian-sun-logo.png" alt="Iberian Sun Logo" class="h-10 w-auto object-contain" />
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
    {services.map((item) => (
      <div class={`reveal-on-scroll ${item.staggerClass} hover-lift bg-white rounded-3xl p-7 border border-[#EAE3D9] shadow-xs transition-all duration-300 flex flex-col justify-between group hover:border-[#C5A880]/60`}>
        <div>
          <div class="flex items-center justify-between mb-5">
            <span class="text-[10.5px] uppercase font-bold tracking-widest text-[#C5A880] bg-[#132238] px-3 py-1 rounded-md shadow-xs">
              {item.division}
            </span>
            <div class="w-10 h-10 rounded-xl bg-[#F4F0E8] text-[#132238] flex items-center justify-center group-hover:bg-[#C5A880] group-hover:text-white transition-colors duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={item.icon}/></svg>
            </div>
          </div>

          <h3 class="text-lg font-serif font-bold text-[#132238] mb-1.5 group-hover:text-[#9C865F] transition-colors">
            {item.title}
          </h3>
          <p class="text-xs font-semibold text-[#9C865F] uppercase tracking-wider mb-3">
            {item.tagline}
          </p>
          <p class="text-xs md:text-sm text-[#64748B] leading-relaxed font-light">
            {item.description}
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-[#EAE3D9]/60 flex items-center justify-between text-xs font-medium text-[#132238]">
          <span class="text-[#64748B]">Ver detalles de división</span>
          <a href={item.link} class="text-[#9C865F] hover:text-[#132238] flex items-center gap-1 font-semibold group/link">
            <span>Conocer más</span>
            <svg class="w-3.5 h-3.5 transform group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    ))}
  </div>

  <!-- Enlace al Hub Completo de Propietarios -->
  <div class="mt-12 text-center reveal-scale">
    <a 
      href="/propietarios/" 
      class="inline-flex items-center gap-2 bg-[#132238] hover:bg-[#1C3252] text-white font-semibold text-xs uppercase tracking-wider py-4 px-8 rounded-full shadow-lg hover:shadow-xl transition-all transform active:scale-95 group/hubbtn border border-[#C5A880]/30"
    >
      <span>Descubrir Todo el Hub de Propietarios (Ciclo 360°)</span>
      <svg class="w-4 h-4 text-[#C5A880] transform group-hover/hubbtn:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
    </a>
  </div>
</section>

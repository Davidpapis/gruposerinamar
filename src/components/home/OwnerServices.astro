---
const services = [
  {
    title: "Inspecciones Periódicas de Viviendas",
    tagline: "Tranquilidad para propietarios ausentes",
    description: "Revisiones semanales, quincenales o mensuales de su propiedad en Marbella: comprobación de cerraduras, ventilación, detección de humedades, fugas y estado general.",
    division: "JUST BANÚS",
    link: "/divisiones/just-banus/",
    icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4",
    staggerClass: "stagger-1"
  },
  {
    title: "Mantenimiento Técnico y Averías 24/7",
    tagline: "Electricidad, fontanería y climatización",
    description: "Solución inmediata de cualquier incidencia técnica en su inmueble con profesionales cualificados y homologados. Nunca se quede sin luz, agua ni aire acondicionado.",
    division: "JUST BANÚS",
    link: "/divisiones/just-banus/",
    icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z",
    staggerClass: "stagger-2"
  },
  {
    title: "Reformas Integrales y Decoración",
    tagline: "Albañilería, microcemento y Home Staging",
    description: "Transformamos su vivienda para aumentar su valor de venta o maximizar sus tarifas por noche en alquiler turístico. Proyectos llave en mano con dirección de obra.",
    division: "JUST BANÚS REFORMS",
    link: "/divisiones/just-banus/",
    icon: "M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01",
    staggerClass: "stagger-3"
  },
  {

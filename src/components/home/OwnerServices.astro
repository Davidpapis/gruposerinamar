    division: "IBERIAN SUN",
    link: "/divisiones/iberian-sun/",
    icon: "M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z",
    staggerClass: "stagger-1"
  },
  {
    title: "Licencias Turísticas y Eficiencia",
    tagline: "Legalización y registro oficial VFT",
    description: "Tramitación de la declaración responsable de vivienda con fines turísticos ante la Junta de Andalucía, certificados de eficiencia energética obligatorios y adecuación legal.",
    division: "JUST BANÚS ADMIN",
    link: "/divisiones/just-banus/",
    icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
    staggerClass: "stagger-2"
  },
  {
    title: "Alquiler de Trasteros Privados",
    tagline: "Espacios seguros y custodiados en Marbella",
    description: "Guarde pertenencias privadas, lencería personal o material deportivo de forma 100% segura mientras su propiedad se encuentra en alquiler o durante obras.",
    division: "JUST BANÚS STORAGES",
    link: "/divisiones/just-banus/",
    icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4",
    staggerClass: "stagger-3"
  }

        <div class="luxury-photo-box destination__detail">
          <img class="w-full h-full object-cover" src="/images/hero/naranjos-fase2.webp" alt={copy.poolAlt} width="1574" height="1050" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="trust-story site-shell reveal-on-scroll" aria-labelledby="trust-heading">
    <div><p class="site-eyebrow">{copy.trustEyebrow}</p><h2 id="trust-heading">{copy.trustTitle}</h2></div>
    <div><p>{copy.trustCopy}</p><a class="site-link" href="/sobre-nosotros/">{copy.trustCta}<span aria-hidden="true">↗</span></a></div>
  </section>

  <!-- BANNER CENTRO DE AYUDA / FAQ (SAC FRESHDESK) -->
  <section class="site-section bg-[#FAF8F5] border-y border-[#EAE3D9] py-14 reveal-scale">
    <div class="site-shell flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="max-w-2xl">
        <p class="site-eyebrow">{en ? 'Support & Knowledge Base' : 'Atención al Cliente · SAC'}</p>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#132238] mb-3">
          {en ? 'Have questions? Explore our Help Center & FAQ' : '¿Tienes dudas? Consulta nuestro Centro de Ayuda & FAQ'}
        </h2>
        <p class="text-xs sm:text-sm text-[#5c6570] leading-relaxed mb-4">
          {en 
            ? 'Find instant answers regarding check-in, key collection, maintenance, non-resident taxes (Modelo 210) and holding services. You can also open an official Freshdesk support ticket.'
            : 'Respuestas inmediatas sobre check-in, recogida de llaves, mantenimiento técnico, fiscalidad de no residentes (Modelo 210) y servicios de todo el holding. También puedes abrir un ticket de soporte oficial.'}
        </p>
        <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-[#806847]">
          <span>✓ {en ? '37 Official Answers' : '37 Respuestas Oficiales'}</span>
          <span>✓ {en ? 'Integrated Search' : 'Buscador Integrado'}</span>
          <span>✓ {en ? 'Freshdesk SAC Support Tickets' : 'Tickets de Soporte Freshdesk SAC'}</span>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0 w-full md:w-auto">
        <a class="site-button btn-shine" href={en ? '/en/faq/' : '/faq/'}>
          {en ? 'Explore Help Center & FAQ' : 'Ver Centro de Ayuda & FAQ'}
          <span aria-hidden="true">→</span>
        </a>
        <a class="site-link px-4 py-2.5 border border-[#EAE3D9] rounded-md bg-white hover:border-[#C5A880] transition-colors" href="https://solutionsserinamar.freshdesk.com/support/tickets/new" target="_blank" rel="noopener noreferrer">
          {en ? 'Open Ticket (Freshdesk) ↗' : 'Abrir Ticket (Freshdesk) ↗'}
        </a>
      </div>
    </div>
  </section>

  <section class="contact-band reveal-on-scroll">
    <div class="site-shell contact-band__inner">
      <div><p class="site-eyebrow">{copy.contactEyebrow}</p><h2>{copy.contactTitle}</h2><p>{copy.contactCopy}</p></div>
      <a class="site-button btn-shine" href="/contacto/">{copy.contactCta}<span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <Footer slot="footer" currentLang={lang} />
</BaseLayout>
<style>
  h2{font-size:clamp(32px,3.3vw,46px);line-height:1.17;letter-spacing:-.035em;font-weight:500;text-wrap:balance;}
  .site-eyebrow{margin-bottom:16px;}
  .section-intro{font-size:15px;line-height:1.85;color:var(--site-muted);margin-block:22px 28px;max-width:490px;}
  .home-hero{position:relative;isolation:isolate;min-height:530px;display:flex;align-items:center;margin:0 24px;border-radius:8px;overflow:hidden;color:#fff;background:#294550;}
  .home-hero__image,.home-hero__shade{position:absolute;inset:0;width:100%;height:100%;z-index:-1;}
  .home-hero__image{object-fit:cover;object-position:center 60%;}
  .home-hero__shade{background:linear-gradient(90deg,#102a32d9 0%,#122a35ab 28%,#162b3630 65%,#162b3608 100%);}
  .home-hero__content{padding-block:68px;}
  .home-hero .site-eyebrow{color:#f0dfc3;margin-bottom:22px;}
  .home-hero h1{font-size:clamp(44px,4.5vw,66px);font-weight:500;letter-spacing:-.045em;line-height:1.12;}
  .home-hero h1 em{font-weight:400;color:#f2dfbe;}
  .home-hero__intro{max-width:450px;font-size:15px;line-height:1.85;color:#f8f5f0;margin-top:24px;}
  .home-hero__actions{display:flex;align-items:center;gap:28px;margin-top:30px;flex-wrap:wrap;}
  .hero-owner{display:inline-flex;gap:20px;align-items:center;border-bottom:1px solid #ffffff70;font-size:13px;padding-block:12px;}
  .home-hero__caption{position:absolute;bottom:22px;right:30px;display:flex;gap:16px;font-size:10px;letter-spacing:.08em;text-shadow:0 1px 4px #000;}
  .quick-paths{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid var(--site-line);padding-block:28px;}
  .quick-paths>a{display:flex;align-items:center;gap:18px;padding:8px 26px;border-right:1px solid var(--site-line);}
  .quick-paths>a:first-child{padding-left:0;}.quick-paths>a:last-child{border:0;padding-right:0;}
  .quick-paths__number{font:italic 24px var(--font-serif);color:#a78a62;}
  .quick-paths strong{display:block;font-weight:600;font-size:13px;}
  .quick-paths small{display:block;color:var(--site-muted);font-size:11px;margin-top:3px;}
  .quick-paths__arrow{margin-left:auto;color:#826340;font-size:20px;}.quick-paths a:hover strong{color:#826340;}
  .owner-feature{background:#f0ebe2;}
  .owner-feature__grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;}
  .owner-feature__visual{position:relative;}
  .owner-feature__visual>img{width:100%;height:565px;object-fit:cover;border-radius:6px;}
  .owner-feature__note{position:absolute;bottom:24px;left:24px;padding:18px 24px;background:#fdfbf7f2;border-radius:3px;min-width:210px;}
  .owner-feature__note span{font:25px var(--font-serif);display:block;}.owner-feature__note small{font-size:11px;color:var(--site-muted);}
  .owner-services{padding:0;margin:0 0 28px;list-style:none;}
  .owner-services li{display:flex;gap:17px;border-top:1px solid #d8d1c5;padding-block:17px;}
  .service-number{font-size:11px;color:#987448;margin-top:3px;}.owner-services h3{font-family:var(--font-sans);font-size:13px;font-weight:600;}.owner-services p{font-size:12px;color:var(--site-muted);margin-top:3px;line-height:1.7;}
  .destination__grid{display:grid;grid-template-columns: .85fr 1.15fr;align-items:center;gap:90px;}
  .destination__photos{position:relative;padding:0 0 50px 45px;}
  .destination__main{height:420px;width:100%;object-fit:cover;border-radius:6px;}
  .destination__detail{position:absolute;left:0;bottom:0;width:49%;height:190px;object-fit:cover;border:7px solid #fdfbf7;border-radius:4px;}
  .trust-story{display:grid;grid-template-columns:1fr 1fr;gap:80px;border-top:1px solid var(--site-line);border-bottom:1px solid var(--site-line);padding-block:50px;}
  .trust-story p:not(.site-eyebrow){font-size:14px;line-height:1.85;color:var(--site-muted);margin-bottom:12px;max-width:490px;}
  .group-brands>h2{max-width:650px;}
  .brands-carousel-container{position:relative;width:100%;overflow:hidden;margin-top:36px;padding-block:12px;mask-image:linear-gradient(to right,transparent 0%,#000 7%,#000 93%,transparent 100%);-webkit-mask-image:linear-gradient(to right,transparent 0%,#000 7%,#000 93%,transparent 100%);}
  .brands-carousel-track{display:flex;gap:24px;width:max-content;animation:marquee 28s linear infinite;will-change:transform;}
  .brands-carousel-container:hover .brands-carousel-track{animation-play-state:paused;}
  @keyframes marquee{0%{transform:translateX(0);}100%{transform:translateX(calc(-50% - 12px));}}
  .brand-card-slide{flex:0 0 310px;padding:24px 22px 20px;border:1px solid var(--site-line);background:#fff;border-radius:12px;display:flex;flex-direction:column;gap:16px;text-decoration:none;box-shadow:0 4px 14px rgba(19,34,56,.04);transition:transform .24s var(--ease-out),border-color .24s var(--ease-out),box-shadow .24s var(--ease-out);position:relative;}
  .brand-card-slide:hover{transform:translateY(-4px);border-color:#C5A880;box-shadow:0 12px 26px -8px rgba(19,34,56,.12);}
  .brand-card-slide__logo{height:95px;display:flex;align-items:center;justify-content:center;}
  .brand-card-slide__logo img{max-height:80px;max-width:180px;width:auto;object-fit:contain;transition:transform .2s;}
  .brand-card-slide:hover .brand-card-slide__logo img{transform:scale(1.04);}
  .brand-card-slide__info{border-top:1px solid var(--site-line);padding-top:14px;display:flex;flex-direction:column;gap:4px;}
  .brand-card-slide__name{font-size:13px;font-weight:700;color:#132238;letter-spacing:.02em;}
  .brand-card-slide__desc{font-size:12px;color:var(--site-muted);line-height:1.45;}
  .brand-card-slide__arrow{position:absolute;top:20px;right:20px;font-size:18px;color:#C5A880;transition:transform .2s;}
  .brand-card-slide:hover .brand-card-slide__arrow{transform:translate(2px,-2px);color:#132238;}
  .contact-band{background:#eae1d2;padding-block:56px;}.contact-band__inner{display:flex;justify-content:space-between;align-items:center;gap:32px;}.contact-band h2{font-size:38px;}.contact-band p:not(.site-eyebrow){font-size:14px;margin-top:16px;color:#52616b;}.contact-band .site-button{flex-shrink:0;}
  @media(max-width:1100px){.quick-paths>a{padding-inline:18px;gap:12px;}.quick-paths__number{display:none;}.owner-feature__grid,.destination__grid{gap:40px;}.owner-feature__visual>img{height:550px;}.group-brands__grid{gap:12px;}}
  @media(max-width:767px){
    .home-hero{margin:0 12px;min-height:460px;}.home-hero__content{padding-block:46px 58px;}.home-hero h1{font-size:42px;}.home-hero__image{object-position:64% center;}.home-hero__shade{background:linear-gradient(90deg,#102a32d9,#122a3570);}.home-hero .site-eyebrow{font-size:9px;letter-spacing:.12em;}.home-hero__intro{font-size:14px;max-width:340px;margin-top:20px;}.home-hero__actions{gap:20px;margin-top:24px;}.home-hero .site-button{padding-inline:16px;font-size:12px;gap:14px;}.hero-owner{font-size:12px;gap:12px;}.home-hero__caption{font-size:9px;right:20px;bottom:16px;}
    .quick-paths{padding-block:18px;width:calc(100% - 40px);}.quick-paths>a{padding:2px 12px;display:block;}.quick-paths strong{font-size:11px;line-height:1.5;}.quick-paths small{display:none;}.quick-paths__arrow{font-size:16px;display:block;margin-top:4px;}
    .owner-feature__grid,.destination__grid{grid-template-columns:1fr;gap:32px;}.owner-feature__visual>img{height:320px;}.owner-feature__note{left:18px;bottom:18px;padding:12px 18px;}.owner-feature__copy h2{max-width:360px;}.owner-feature__copy{grid-row:1;}.owner-feature__visual{grid-row:2;}
    .destination__photos{padding:0 0 36px 24px;}.destination__main{height:300px;}.destination__detail{height:145px;}.section-intro{font-size:14px;margin-block:18px 20px;}
    .trust-story{grid-template-columns:1fr;gap:20px;padding-block:38px;}.group-brands__grid{grid-template-columns:1fr 1fr;gap:12px;margin-top:24px;}.group-brands__grid>a{padding:12px;font-size:10px;gap:8px;}.group-brands__logo{height:80px;margin-bottom:4px;}.group-brands__logo img{max-width:120px;height:70px;}.contact-band{padding-block:40px;}.contact-band__inner{align-items:flex-start;flex-direction:column;gap:24px;}.contact-band h2{font-size:32px;}
  }
  @media(max-width:370px){.home-hero h1{font-size:38px;}.home-hero__actions{gap:12px;}.hero-owner{gap:8px;}.home-hero .site-button{padding-inline:12px;}.site-eyebrow{font-size:10px;}}
</style>

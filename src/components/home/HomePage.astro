          </ul>
          <div class="pt-5 border-t border-[#EAE3D9] mt-auto flex flex-col gap-2.5">
            <a href="/divisiones/iberian-sun/" class="btn-shine w-full inline-flex items-center justify-between px-4 py-2.5 rounded-xl bg-[#132238] hover:bg-[#203654] text-white text-xs font-semibold uppercase tracking-wider transition-all duration-300 shadow-xs group/btn">
              <span>{en ? 'Explore Iberian Sun' : 'Conocer Iberian Sun'}</span>
              <span class="text-base text-[#C5A880] group-hover/btn:translate-x-1 transition-transform">→</span>
            </a>
            <div class="flex items-center justify-between px-1 text-[11px]">
              <span class="text-[#8A94A0]">{en ? 'Direct access:' : 'Acceso directo:'}</span>

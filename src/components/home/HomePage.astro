---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import FeaturedProperties from './FeaturedProperties.astro';
interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const en = lang === 'en';
const copy = en ? {
  title: 'Holiday stays & property care in Marbella | Serinamar',
  description: 'Discover holiday stays in Marbella and a local team to look after your property. Serinamar, in Los Naranjos since 2000.',
  eyebrow: 'MARBELLA · PUERTO BANÚS · SINCE 2000',
  headline: 'Your place in Marbella.',
  headlineTwo: 'In good hands.',
  intro: 'A holiday to look forward to. A home to feel good about. Discover our stays and local property services.',
  primary: 'Find a holiday stay', secondary: 'I own a property', photo: 'Puerto Banús marina at sunset',
  quick: [ ['01','Stay in Marbella','Find your next holiday home','/alojamientos/'],['02','Care for your property','A local team, all year round','/propietarios/'],['03','Buy or sell','Take the next step with us','/divisiones/serinamar/'] ],
  ownerEyebrow: 'FOR PROPERTY OWNERS', ownerTitle: 'Your home, cared for. Wherever you are.',
  ownerCopy: 'From holiday rentals to day-to-day maintenance, we bring together the people and services your property needs.',
  services: [ ['Holiday rental management','From preparing your home to welcoming your guests.'],['Maintenance & renovations','Inspections, repairs and thoughtful improvements.'],['Support for non-residents','Help with paperwork and tax administration, in your language.'] ],
  ownerCta: 'Explore owner services', ownerImage: 'Bright dining room opening onto a terrace',
  placeEyebrow: 'LOS NARANJOS DE MARBELLA', placeTitle: 'A little more time for the good things.',
  placeCopy: 'Breakfast on the terrace. An afternoon by the pool. A walk around Puerto Banús. A Mediterranean setting to enjoy at your own pace.',
  placeCta: 'Discover Los Naranjos', placeImage: 'Covered terrace with outdoor dining area in Los Naranjos', poolAlt: 'Communal pool and gardens in Los Naranjos de Marbella',
  trustEyebrow: 'LOCAL KNOWLEDGE. PERSONAL SERVICE.',trustTitle: 'Here for you, since 2000.',
  trustCopy: 'Our story began in Marbella. Today, we continue to welcome guests and support property owners with the same personal approach.',trustCta: 'Meet the group',
  brandsEyebrow: 'THE SERINAMAR GROUP',brandsTitle: 'Three specialized divisions. One trusted team.',
  brands: [ ['Serinamar','Holiday stays & real estate (integrating Los Naranjos)','serinamar'],['Just Banús','Dedicated home care, maintenance & renovations','just-banus'],['Iberian Sun','International & UK owner advisory','iberian-sun'] ],
  contactEyebrow: 'LET’S TALK',contactTitle: 'What brings you to Marbella?',contactCopy: 'Tell us what you need. We will help you take the next step.',contactCta:'Contact our team'
} : {
  title: 'Alojamientos y gestión en Marbella | Grupo Serinamar',
  description: 'Tu estancia y tu propiedad en Marbella, en buenas manos. Alojamientos vacacionales y servicios para propietarios con un equipo local desde 2000.',
  eyebrow: 'MARBELLA · PUERTO BANÚS · DESDE 2000',
  headline: 'Tu lugar en Marbella.',
  headlineTwo: 'En buenas manos.',
  intro: 'Una estancia para disfrutar. Una propiedad para confiar. Descubre nuestros alojamientos y un equipo local que cuida de cada detalle.',
  primary: 'Buscar alojamiento', secondary: 'Soy propietario', photo: 'Puerto Banús y su puerto deportivo al atardecer',
  quick: [ ['01','Disfrutar de Marbella','Encuentra tu próxima estancia','/alojamientos/'],['02','Cuidar mi propiedad','Un equipo local, todo el año','/propietarios/'],['03','Comprar o vender','Te acompañamos en el siguiente paso','/divisiones/serinamar/'] ],
  ownerEyebrow: 'PARA PROPIETARIOS', ownerTitle: 'Tu casa, cuidada. Estés donde estés.',
  ownerCopy: 'Del alquiler vacacional al mantenimiento diario. Reunimos a las personas y los servicios que tu vivienda necesita.',
  services: [ ['Gestión del alquiler','Desde preparar tu vivienda hasta recibir a tus huéspedes.'],['Mantenimiento y reformas','Revisiones, reparaciones y mejoras para tu casa.'],['Asistencia a no residentes','Ayuda con trámites y gestión fiscal, en tu idioma.'] ],
  ownerCta: 'Servicios para propietarios', ownerImage: 'Comedor luminoso con acceso a una terraza',
  placeEyebrow: 'LOS NARANJOS DE MARBELLA', placeTitle: 'Más tiempo para lo que te hace bien.',
  placeCopy: 'Desayunar en la terraza. Una tarde junto a la piscina. Pasear por Puerto Banús. Un entorno mediterráneo para disfrutar a tu ritmo.',
  placeCta: 'Descubrir Los Naranjos',placeImage:'Terraza cubierta con comedor exterior en Los Naranjos',poolAlt:'Piscina comunitaria y jardines de Los Naranjos de Marbella',
  trustEyebrow: 'CERCANÍA Y EXPERIENCIA LOCAL',trustTitle: 'A tu lado, desde 2000.',
  trustCopy: 'Nuestra historia empezó en Marbella. Hoy seguimos recibiendo a huéspedes y acompañando a propietarios con el mismo trato cercano.',trustCta:'Conocer al grupo',
  brandsEyebrow: 'CONJUNTO SERINAMAR',brandsTitle: 'Tres divisiones especializadas. Un solo equipo de confianza.',
  brands: [ ['Serinamar','Alquiler vacacional (Hospitality) e inmobiliaria (integra Los Naranjos)','serinamar'],['Just Banús','Cuidado integral, mantenimiento, reformas y servicios','just-banus'],['Iberian Sun','Asesoría y gestión internacional para no residentes y UK','iberian-sun'] ],
  contactEyebrow:'HABLEMOS',contactTitle:'¿Qué te trae a Marbella?',contactCopy:'Cuéntanos qué necesitas. Te ayudamos a dar el siguiente paso.',contactCta:'Contactar con el equipo'
};
---
<BaseLayout title={copy.title} description={copy.description} canonicalURL={`https://gruposerinamar.com/${en ? 'en/' : ''}`} lang={lang}>
  <Header slot="header" currentLang={lang} />
  <!-- 3. HERO SECTION CINEMATOGRÁFICO MARBELLA (FULL VIEWPORT) -->
  <section class="relative min-h-[calc(100vh-110px)] min-h-[calc(100dvh-110px)] flex flex-col justify-center px-4 sm:px-8 py-6 sm:py-8 lg:py-10 bg-gradient-to-b from-[#132238] via-[#1B2F4C] to-[#132238] text-white overflow-hidden">
    
    <!-- Imagen de fondo con opacidad elegante -->
    <div class="absolute inset-0 z-0 opacity-25 mix-blend-luminosity scale-105 filter blur-[1px]">
      <img 
        src="/images/hero/puerto-banus-panorama.webp" 
        alt="Marbella Puerto Banús Panorama" 
        class="w-full h-full object-cover"
        fetchpriority="high"
      />
    </div>
    
    <div class="max-w-6xl mx-auto w-full relative z-10 flex flex-col justify-center my-auto">
      
      <div class="text-center max-w-3xl mx-auto mb-5 sm:mb-6">
        <div class="animate-hero-eyebrow inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 backdrop-blur-md border border-[#C5A880]/40 text-[#C5A880] text-xs font-semibold uppercase tracking-widest mb-3 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#C5A880] animate-pulse"></span>
          <span>{en ? 'Corporate Holding · Marbella & Puerto Banús' : 'Holding Corporativo · Marbella & Puerto Banús'}</span>
        </div>

        <h1 class="animate-hero-title text-2xl sm:text-4xl lg:text-[44px] font-serif font-bold text-white leading-[1.18] mb-3 tracking-tight">
          {en ? 'One Single Group. Every Need for Your Property in Marbella.' : 'Un Solo Grupo. Todas las Necesidades de su Propiedad en Marbella.'}
        </h1>

        <p class="animate-hero-copy text-xs sm:text-sm md:text-[15px] text-[#EAE3D9] font-light leading-relaxed max-w-2xl mx-auto mb-3.5">
          {en ? (
            <>Since 2000, <strong>Grupo Serinamar</strong> brings together leading companies to accompany you throughout the property lifecycle: sales, holiday rentals powered by Guesty, day-to-day care with <strong>Just Banús</strong> and non-resident tax advisory with <strong>Iberian Sun</strong>.</>
          ) : (
            <>Desde el año 2000, <strong>Grupo Serinamar</strong> reúne empresas líderes para acompañarle en todo el ciclo del inmueble: compraventa, alquiler vacacional con motor Guesty, cuidado diario con <strong>Just Banús</strong> y asesoría tributaria a no residentes con <strong>Iberian Sun</strong>.</>
          )}
        </p>

        <!-- Métricas Comprobadas Compactas con Contadores Animados -->
        <div class="animate-hero-stats inline-flex flex-wrap items-center justify-center gap-3 sm:gap-6 py-1.5 px-5 rounded-full bg-white/5 border border-white/10 text-center backdrop-blur-xs">
          <div class="flex items-center gap-1.5">
            <span class="stat-counter text-sm sm:text-base font-serif font-bold text-[#C5A880]" data-target="25" data-prefix="+">{en ? '+25 Years' : '+25 Años'}</span>
            <span class="text-[10px] sm:text-[11px] uppercase tracking-wider text-[#EAE3D9]/70 font-medium">{en ? 'Track Record' : 'Trayectoria'}</span>
          </div>
          <span class="text-white/20 hidden sm:inline">·</span>
          <div class="flex items-center gap-1.5">
            <span class="stat-counter text-sm sm:text-base font-serif font-bold text-[#C5A880]" data-target="150" data-prefix="+">+150</span>
            <span class="text-[10px] sm:text-[11px] uppercase tracking-wider text-[#EAE3D9]/70 font-medium">{en ? 'Properties' : 'Propiedades'}</span>
          </div>
          <span class="text-white/20 hidden sm:inline">·</span>
          <div class="flex items-center gap-1.5">
            <span class="stat-counter text-sm sm:text-base font-serif font-bold text-[#C5A880]" data-target="4.8" data-suffix=" ★">4.8 ★</span>
            <span class="text-[10px] sm:text-[11px] uppercase tracking-wider text-[#EAE3D9]/70 font-medium">{en ? 'Guest Rating' : 'Huéspedes'}</span>
          </div>
          <span class="text-white/20 hidden sm:inline">·</span>
          <div class="flex items-center gap-1.5">
            <span class="stat-counter text-sm sm:text-base font-serif font-bold text-[#C5A880]" data-target="360" data-suffix="°">360°</span>
            <span class="text-[10px] sm:text-[11px] uppercase tracking-wider text-[#EAE3D9]/70 font-medium">{en ? 'Management' : 'Gestión'}</span>
          </div>
        </div>
      </div>

      <!-- 4. BUSCADOR DUAL (GUESTY VACACIONAL + INMOWEB VENTA) -->
      <div id="buscador" class="animate-hero-search relative z-20 w-full max-w-5xl mx-auto rounded-2xl bg-white shadow-2xl border border-[#EAE3D9] overflow-hidden text-[#132238]">
        
        <!-- Pestañas -->
        <div class="flex border-b border-[#EAE3D9] bg-[#F4F0E8]">
          <button 
            id="btn-tab-vacational" 
            type="button"
            class="flex-1 py-4 px-6 text-center font-medium text-sm md:text-base flex items-center justify-center gap-2.5 border-b-2 border-[#132238] bg-white text-[#132238] transition-colors"
          >
            <img src="/images/logos/casita logo NO BG.png" alt="" class="w-5 h-5 object-contain shrink-0" />
            <span>{en ? 'Direct Holiday Rentals' : 'Alquiler Vacacional Directo'} <strong class="text-xs font-semibold px-2 py-0.5 rounded-full bg-[#EAE3D9] text-[#132238] hidden sm:inline">Guesty PMS</strong></span>
          </button>
          
          <button 
            id="btn-tab-realestate" 
            type="button"
            class="flex-1 py-4 px-6 text-center font-medium text-sm md:text-base flex items-center justify-center gap-2.5 text-[#64748B] hover:text-[#132238] transition-colors"
          >
            <img src="/images/logos/casita logo NO BG.png" alt="" class="w-5 h-5 object-contain shrink-0 opacity-70" />
            <span>{en ? 'Real Estate & Investment' : 'Compraventa e Inversión'} <strong class="text-xs font-semibold px-2 py-0.5 rounded-full bg-[#EAE3D9] text-[#132238] hidden sm:inline">Serinamar MLS</strong></span>
          </button>
        </div>

        <!-- Formulario Vacacional (Guesty) -->
        <form id="view-vacational" class="p-5 md:p-7 block">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
            <div>
              <label for="inp-checkin" class="block text-xs font-semibold uppercase tracking-wider text-[#64748B] mb-1.5">{en ? 'Check-in' : 'Llegada'}</label>
              <input type="date" id="inp-checkin" class="w-full bg-[#F9F8F6] border border-[#EAE3D9] rounded-xl px-3.5 py-3 text-sm text-[#132238] font-medium focus:ring-2 focus:ring-[#C5A880] outline-none" />
            </div>
            <div>
              <label for="inp-checkout" class="block text-xs font-semibold uppercase tracking-wider text-[#64748B] mb-1.5">{en ? 'Check-out' : 'Salida'}</label>
              <input type="date" id="inp-checkout" class="w-full bg-[#F9F8F6] border border-[#EAE3D9] rounded-xl px-3.5 py-3 text-sm text-[#132238] font-medium focus:ring-2 focus:ring-[#C5A880] outline-none" />
            </div>
            <div>
              <label for="inp-guests" class="block text-xs font-semibold uppercase tracking-wider text-[#64748B] mb-1.5">{en ? 'Guests' : 'Huéspedes'}</label>
              <select id="inp-guests" class="w-full bg-[#F9F8F6] border border-[#EAE3D9] rounded-xl px-3.5 py-3 text-sm text-[#132238] font-medium focus:ring-2 focus:ring-[#C5A880] outline-none">
                <option value="1">{en ? '1 Guest' : '1 Huésped'}</option>
                <option value="2" selected>{en ? '2 Guests' : '2 Huéspedes'}</option>
                <option value="3">{en ? '3 Guests' : '3 Huéspedes'}</option>
                <option value="4">{en ? '4 Guests' : '4 Huéspedes'}</option>
                <option value="5">{en ? '5+ Guests' : '5+ Huéspedes'}</option>
              </select>
            </div>
            <div>
              <button type="submit" class="btn-shine w-full bg-[#132238] hover:bg-[#1E3557] text-white font-medium text-sm md:text-[15px] py-3.5 px-6 rounded-xl shadow-md transition-all flex items-center justify-center gap-2 border border-[#C5A880]/30 cursor-pointer">
                <svg class="w-4 h-4 text-[#C5A880]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <span>{en ? 'Search Availability' : 'Buscar Disponibilidad'}</span>
              </button>
            </div>
          </div>
          <div class="mt-4 pt-3.5 border-t border-[#EAE3D9]/60 flex flex-wrap items-center justify-between text-xs text-[#64748B] gap-2">
            <span>{en ? '✓ Best direct rate guaranteed' : '✓ Mejor tarifa directa garantizada'}</span>
            <span>{en ? '✓ On-site reception at Los Naranjos' : '✓ Recepción física en Los Naranjos'}</span>
            <span>{en ? '✓ Door-to-door Málaga Airport transfers' : '✓ Transfers puerta a puerta al Aeropuerto de Málaga'}</span>
          </div>
        </form>

        <!-- Formulario Inmobiliario: Sólo Botón de Catálogo -->
        <div id="view-realestate" class="p-5 md:p-7 hidden">
          <div class="flex flex-col md:flex-row items-center justify-between gap-6 py-2">
            <div class="max-w-xl text-center md:text-left">
              <span class="inline-block text-xs font-semibold uppercase tracking-wider text-[#806847] mb-1">
                {en ? 'Serinamar · Hospitality & Real Estate' : 'Serinamar · Hospitality & Real Estate'}
              </span>
              <h3 class="text-lg sm:text-xl font-serif font-semibold text-[#132238]">
                {en ? 'Property Portfolio & Real Estate Investment in Marbella' : 'Cartera de Inmuebles e Inversión Inmobiliaria en Marbella'}
              </h3>
              <p class="text-xs sm:text-sm text-[#5c6570] mt-1 leading-relaxed">
                {en 
                  ? 'Apartments, duplex penthouses and exclusive villas for sale and long-term rental in Los Naranjos, Puerto Banús and Nueva Andalucía.' 
                  : 'Apartamentos, áticos dúplex y villas exclusivas en venta y alquiler de larga temporada en Los Naranjos, Puerto Banús y Nueva Andalucía.'}
              </p>
            </div>
            <div class="w-full md:w-auto flex-shrink-0">
              <a 
                href="https://www.serinamar.com/results?id_tipo_operacion=1" 
                target="_blank" 
                rel="noopener noreferrer"
                class="btn-shine w-full md:w-auto inline-flex items-center justify-center gap-2.5 bg-[#132238] hover:bg-[#1E3557] text-white font-medium text-sm sm:text-base py-3.5 px-8 rounded-xl shadow-md transition-all border border-[#C5A880]/30 hover:shadow-lg group cursor-pointer"
              >
                <svg class="w-5 h-5 text-[#C5A880]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                <span>{en ? 'View Properties Catalog' : 'Ver Catálogo de Inmuebles'}</span>
                <span aria-hidden="true" class="text-[#C5A880] transition-transform group-hover:translate-x-1">↗</span>
              </a>
            </div>
          </div>
          <div class="mt-4 pt-3.5 border-t border-[#EAE3D9]/60 flex flex-wrap items-center justify-between text-xs text-[#64748B] gap-2">
            <span>{en ? '✓ Verified listings & official valuations' : '✓ Inmuebles verificados y valoraciones oficiales'}</span>
            <span>{en ? '✓ Full purchase & investment advisory' : '✓ Asesoramiento integral en compraventa e inversión'}</span>
            <a href="tel:+34952813362" class="text-[#C5A880] font-semibold hover:underline">{en ? 'Direct advisory: +34 952 81 33 62' : 'Asesor personal: +34 952 81 33 62'}</a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <script>
    function setupDualSearch() {
      const btnVac = document.getElementById('btn-tab-vacational');
      const btnReal = document.getElementById('btn-tab-realestate');
      const viewVac = document.getElementById('view-vacational');
      const viewReal = document.getElementById('view-realestate');

      if (!btnVac || !btnReal || !viewVac || !viewReal) return;

      btnVac.addEventListener('click', () => {
        btnVac.className = "flex-1 py-4 px-6 text-center font-medium text-sm md:text-base flex items-center justify-center gap-2 border-b-2 border-[#132238] bg-white text-[#132238] transition-colors cursor-pointer";
        btnReal.className = "flex-1 py-4 px-6 text-center font-medium text-sm md:text-base flex items-center justify-center gap-2 text-[#64748B] hover:text-[#132238] transition-colors cursor-pointer";
        viewVac.classList.remove('hidden');
        viewVac.classList.add('block');
        viewReal.classList.add('hidden');
      });

      btnReal.addEventListener('click', () => {
        btnReal.className = "flex-1 py-4 px-6 text-center font-medium text-sm md:text-base flex items-center justify-center gap-2 border-b-2 border-[#132238] bg-white text-[#132238] transition-colors cursor-pointer";
        btnVac.className = "flex-1 py-4 px-6 text-center font-medium text-sm md:text-base flex items-center justify-center gap-2 text-[#64748B] hover:text-[#132238] transition-colors cursor-pointer";
        viewReal.classList.remove('hidden');
        viewVac.classList.remove('block');
        viewVac.classList.add('hidden');
      });

      viewVac.addEventListener('submit', (e) => {
        e.preventDefault();
        const checkIn = (document.getElementById('inp-checkin') as HTMLInputElement)?.value;
        const checkOut = (document.getElementById('inp-checkout') as HTMLInputElement)?.value;
        const guests = (document.getElementById('inp-guests') as HTMLSelectElement)?.value;

        let targetUrl = 'https://serinamar.guestybookings.com/properties?';
        const params = new URLSearchParams();
        if (guests) params.append('minOccupancy', guests);
        if (checkIn) params.append('checkIn', checkIn);
        if (checkOut) params.append('checkOut', checkOut);

        window.open(targetUrl + params.toString(), '_blank');
      });
    }

    setupDualSearch();
    document.addEventListener('astro:page-load', setupDualSearch);
  </script>

  <!-- SECCIÓN 3 DIVISIONES CORPORATIVAS DEL CONJUNTO SERINAMAR (ESTÁTICAS) -->
  <section class="site-section py-16 sm:py-20 px-4 sm:px-8 bg-[#FDFBF7]" aria-labelledby="divisions-heading">
    <div class="max-w-7xl mx-auto">
      
      <div class="reveal-title text-center max-w-3xl mx-auto mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#132238]/5 border border-[#C5A880]/30 text-[#806847] text-xs font-semibold uppercase tracking-widest mb-4">
          <span class="w-2 h-2 rounded-full bg-[#C5A880]"></span>
          <span>{en ? 'THE SERINAMAR GROUP · THREE SPECIALISED PILLARS' : 'CONJUNTO SERINAMAR · ESTRUCTURA EN 3 BLOQUES'}</span>
        </div>
        <h2 id="divisions-heading" class="text-2xl sm:text-4xl lg:text-[40px] font-serif font-normal text-[#132238] tracking-tight leading-[1.2]">
          {en ? 'Three specialised companies. One single trusted team.' : 'Tres empresas complementarias. Un solo equipo de confianza.'}
        </h2>
        <p class="text-sm sm:text-base text-[#5c6570] mt-3 max-w-2xl mx-auto leading-relaxed">
          {en 
            ? 'Covering every dimension of your property in Marbella: from holiday rentals and real estate to turnkey maintenance and international fiscal advisory.' 
            : 'Acompañamos todo el ciclo de su vivienda en Marbella: desde la comercialización y alquiler vacacional hasta los servicios integrales y la asesoría fiscal internacional.'}
        </p>
      </div>

      <!-- 3 Tarjetas Estáticas con micro-interacciones de lujo -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
        
        <!-- Tarjeta 1: Serinamar -->
        <div class="holding-card reveal-on-scroll stagger-1 group flex flex-col bg-white border border-[#EAE3D9] hover:border-[#C5A880] rounded-2xl p-7 lg:p-8 shadow-sm hover:shadow-xl transition-all duration-300 relative text-[#132238]">
          <div class="h-24 flex items-center justify-center p-3 mb-6 bg-[#FAF8F5] rounded-xl border border-[#EAE3D9]/60 group-hover:border-[#C5A880]/40 transition-colors">
            <img src="/images/logos/serinamar-logo.png" alt="Serinamar" class="holding-card-logo max-h-16 max-w-[200px] w-auto object-contain transition-transform duration-300" loading="lazy" />
          </div>
          <div class="inline-flex items-center gap-1.5 self-start px-3 py-1 rounded-full bg-[#132238]/5 text-[#132238] text-xs font-semibold uppercase tracking-wider mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-[#C5A880]"></span>
            <span>{en ? 'Hospitality & Real Estate' : 'Hospitality & Inmobiliaria'}</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-serif font-semibold text-[#132238] mb-2.5">
            Serinamar
          </h3>
          <p class="text-xs sm:text-sm text-[#5c6570] leading-relaxed mb-6 flex-grow">
            {en 
              ? 'Holiday rental management powered by Guesty (integrating Los Naranjos de Marbella) alongside exclusive property sales and long-term rentals in Marbella and Puerto Banús.' 
              : 'Alquiler vacacional directo con motor Guesty (absorbe y representa lo que era Los Naranjos de Marbella) y compraventa e intermediación inmobiliaria selecta.'}
          </p>
          <ul class="space-y-2 pt-4 border-t border-[#EAE3D9] text-xs text-[#5c6570] mb-6">
            <li class="flex items-center gap-2"><span class="text-[#C5A880] font-bold">✓</span> {en ? 'Direct holiday rentals (Guesty PMS)' : 'Alquiler vacacional directo (Guesty PMS)'}</li>

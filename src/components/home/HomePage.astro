      <div class="owner-feature__visual luxury-photo-box reveal-scale stagger-1">
        <img src="/images/hero/serinamar-villa-header.jpg" alt={copy.ownerImage} width="2496" height="1665" loading="lazy" />
        <div class="owner-feature__note"><span>Just Banús</span><small>{en ? 'Your home. Taken care of.' : 'Tu casa, siempre cuidada.'}</small></div>
      </div>
      <div class="owner-feature__copy reveal-on-scroll stagger-2">
        <p class="site-eyebrow">{copy.ownerEyebrow}</p>
        <h2 id="owner-heading">{copy.ownerTitle}</h2>
        <p class="section-intro">{copy.ownerCopy}</p>
        <ul class="owner-services">{copy.services.map(([title,text],index)=><li class="reveal-on-scroll"><span class="service-number">0{index+1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ul>
        <a class="site-button btn-shine" href="/propietarios/">{copy.ownerCta}<span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="destination site-section" aria-labelledby="place-heading">
    <div class="site-shell destination__grid">
      <div class="destination__copy reveal-on-scroll stagger-1">
        <p class="site-eyebrow">{copy.placeEyebrow}</p>
        <h2 id="place-heading">{copy.placeTitle}</h2>
        <p class="section-intro">{copy.placeCopy}</p>
        <a class="site-link" href="/divisiones/los-naranjos/">{copy.placeCta}<span aria-hidden="true">↗</span></a>
      </div>
      <div class="destination__photos reveal-scale stagger-2">

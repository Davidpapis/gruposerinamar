---
interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  image?: string;
  lang?: 'es' | 'en';
}

const {
  title = "Inmobiliaria y Alquiler en Marbella | Grupo Serinamar",
  description = "Más de 25 años en Marbella. Alquiler vacacional directo con Guesty, compraventa inmobiliaria, mantenimiento con Just Banús y asesoría fiscal Iberiansun.",
  canonicalURL = "https://gruposerinamar.com",
  image = "/images/hero/puerto-banus-panorama.webp",
  lang = "es"
} = Astro.props;

const siteUrl = "https://gruposerinamar.com";

// Breadcrumbs dinámicos para Rich Snippets en Google SERPs
const pathSegments = new URL(canonicalURL, siteUrl).pathname.split('/').filter(Boolean).filter(s => s !== 'en');
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": lang === 'en' ? "Home" : "Inicio",
    "item": lang === 'en' ? `${siteUrl}/en/` : `${siteUrl}/`
  }
];

let accumulated = lang === 'en' ? '/en' : '';
pathSegments.forEach((segment, idx) => {
  accumulated += `/${segment}`;
  let cleanName = segment.replace(/-/g, ' ');
  if (segment === 'just-banus') cleanName = 'Just Banús';
  else if (segment === 'iberian-sun') cleanName = 'Iberiansun';
  else if (segment === 'serinamar') cleanName = 'Serinamar';
  else if (segment === 'los-naranjos') cleanName = 'Los Naranjos';
  else if (segment === 'alojamientos') cleanName = lang === 'en' ? 'Holiday Stays' : 'Alojamientos';
  else if (segment === 'propietarios') cleanName = lang === 'en' ? 'Owners' : 'Propietarios';
  else if (segment === 'sobre-nosotros') cleanName = lang === 'en' ? 'About Us' : 'Sobre Nosotros';
  else if (segment === 'contacto') cleanName = lang === 'en' ? 'Contact' : 'Contacto';
  else if (segment === 'faq') cleanName = 'FAQ';
  else cleanName = cleanName.charAt(0).toUpperCase() + cleanName.slice(1);

  breadcrumbItems.push({
    "@type": "ListItem",
    "position": idx + 2,
    "name": cleanName,
    "item": `${siteUrl}${accumulated}/`
  });
});

// JSON-LD Schema estructurado según Playbook Rank Masters (LocalBusiness + BreadcrumbList)
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "RealEstateAgent", "LocalBusiness"],
      "@id": `${siteUrl}/#organization`,
      "name": "Grupo Serinamar",
      "url": siteUrl,
      "logo": `${siteUrl}/images/logos/serinamar-logo-no-bg.png`,
      "image": `${siteUrl}/images/logos/serinamar-logo-no-bg.png`,
      "description": description,
      "telephone": "+34952813362",
      "email": "info@serinamar.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Urb. Los Naranjos De Marbella, Centro Comercial, Local 5",
        "addressLocality": "Marbella",
        "postalCode": "29660",
        "addressRegion": "Málaga",
        "addressCountry": "ES"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 36.5072,
        "longitude": -4.9504
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "08:00",
          "closes": "16:00"
        }
      ],
      "areaServed": [
        { "@type": "AdministrativeArea", "name": "Marbella" },
        { "@type": "AdministrativeArea", "name": "Puerto Banús" },
        { "@type": "AdministrativeArea", "name": "Nueva Andalucía" },
        { "@type": "AdministrativeArea", "name": "Costa del Sol" }
      ],
      "sameAs": [
        "https://www.facebook.com/serinamar",
        "https://www.instagram.com/serinamar/",
        "https://twitter.com/nmserinamar"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Servicios Inmobiliarios y Gestión de Propiedades",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Alquiler Vacacional Directo",
              "description": "Gestión de reservas y apartamentos turísticos en Los Naranjos y Marbella con motor Guesty PMS."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Compraventa Inmobiliaria",
              "description": "Comercialización, valoración y asesoramiento en compra y venta de viviendas residenciales en Marbella."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Property Management Just Banús",
              "description": "Mantenimiento preventivo, reformas integrales, revisiones periódicas, custodia de llaves y limpieza profesional."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Asesoría Fiscal No Residentes Iberiansun",
              "description": "Liquidación y presentación del Impuesto sobre la Renta de No Residentes (Modelo 210 IRNR), IBI y trámites en España y UK."
            }
          }
        ]
      },
      "department": [
        {
          "@type": "LocalBusiness",
          "name": "Just Banús · Property Management & Owner Services",
          "description": "Cuidado, reformas, mantenimiento integral e inspección de viviendas en Puerto Banús y Marbella."
        },
        {
          "@type": "RealEstateAgent",
          "name": "Serinamar Hospitality & Real Estate",
          "description": "Compraventa y explotación turística de apartamentos y villas en Costa del Sol."
        },
        {
          "@type": "FinancialService",
          "name": "Iberiansun · International Property Services",
          "description": "Asesoría fiscal, gestión documental e impuestos para no residentes en España desde Reino Unido."
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbItems
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Grupo Serinamar",
      "inLanguage": ["es-ES", "en-GB"]
    }
  ]
};
---

<!-- Títulos y Metadatos Esenciales -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description.length > 160 ? description.substring(0, 157) + "..." : description} />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonicalURL} />

<!-- Multilingüe hreflang con x-default -->
<link rel="alternate" hreflang="es" href="https://gruposerinamar.com/" />
<link rel="alternate" hreflang="en" href="https://gruposerinamar.com/en/" />
<link rel="alternate" hreflang="x-default" href="https://gruposerinamar.com/" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, siteUrl).href} />
<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
<meta property="og:site_name" content="Grupo Serinamar" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, siteUrl).href} />

<!-- Favicon & Touch Icons -->
<link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon.png?v=2" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Schema.org JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

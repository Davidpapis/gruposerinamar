---
import SEO from '../components/seo/SEO.astro';
import '../styles/global.css';
import '../styles/redesign.css';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  image?: string;
  lang?: 'es' | 'en';
}

const {
  title,
  description,
  canonicalURL,
  image,
  lang = 'es'
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <SEO 
      title={title} 
      description={description} 
      canonicalURL={canonicalURL} 
      image={image} 
      lang={lang} 
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[#FDFBF7] text-[#132238] selection:bg-[#C5A880] selection:text-white antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#132238] focus:text-white focus:rounded-md focus:shadow-xl">
      {lang === 'en' ? 'Skip to main content' : 'Saltar al contenido principal'}
    </a>
    
    <slot name="header" />
    
    <main id="main-content" class="flex-grow">
      <slot />
    </main>
    
    <slot name="footer" />

  </body>
</html>
